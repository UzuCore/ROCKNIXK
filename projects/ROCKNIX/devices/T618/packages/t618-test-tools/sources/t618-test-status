#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
printf 'RG405M / T618 - emulator-free test image\n\n'
printf 'Kernel: '; uname -r
printf '\nGraphics devices:\n'; ls /dev/dri 2>/dev/null || true
printf '\nInternal display:\n'
for path in /sys/class/drm/card*-DSI-*/status; do
  [ -r "${path}" ] && printf '%s: %s\n' "${path%/status}" "$(cat "${path}")"
done
printf '\nSound cards:\n'; aplay -l 2>/dev/null || true
printf '\nMemory:\n'; free -m
printf '\nController devices:\n'
for path in /sys/class/input/event*/device/name; do
  [ -r "${path}" ] || continue
  name=$(cat "${path}")
  case "${name}" in
    *RG405*|*rg405*|*DualSense*|*Gamepad*) printf '%s\n' "${name}" ;;
  esac
done
printf '\nThis screen closes automatically after 20 seconds.\n'
sleep 20
