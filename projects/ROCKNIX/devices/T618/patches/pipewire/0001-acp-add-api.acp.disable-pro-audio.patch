From: RG405M bring-up <rg405m@localhost>
Subject: [PATCH] acp: add api.acp.disable-pro-audio

---
--- a/spa/plugins/alsa/acp/acp.c	2026-09-29 14:09:21.397680435 +0900
+++ b/spa/plugins/alsa/acp/acp.c	2026-09-29 14:09:21.481129511 +0900
@@ -306,6 +306,14 @@
 	pa_sample_spec ss;
 	snd_pcm_uframes_t try_period_size, try_buffer_size;
 	uint32_t idx;
+	const char *disable;
+
+	/* Some vendor cards (e.g. Unisoc VBC DSP) must not have every PCM opened for probing. */
+	disable = pa_proplist_gets(impl->proplist, "api.acp.disable-pro-audio");
+	if (disable && spa_atob(disable)) {
+		pa_log_info("pro-audio profile disabled by api.acp.disable-pro-audio");
+		return 0;
+	}
 
 	if (impl->use_ucm) {
 		const char *verb = find_best_verb(impl);
