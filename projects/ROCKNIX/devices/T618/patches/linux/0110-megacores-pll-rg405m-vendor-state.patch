From: RG405M bring-up <rg405m@localhost>
Subject: [PATCH] drm/sprd: megacores pll: program the vendor PLL state on Anbernic RG405M

---
--- a/drivers/gpu/drm/sprd/megacores_pll.c
+++ b/drivers/gpu/drm/sprd/megacores_pll.c
@@ -1,3 +1,4 @@
+#include <linux/of.h>
 // SPDX-License-Identifier: GPL-2.0
 /*
  * Copyright (C) 2020 Unisoc Inc.
@@ -96,10 +97,25 @@
 	reg_val[7] = pll->det_delay;
 	reg_val[8] = pll->nint;
 
+	/*
+	 * Anbernic RG405M: reproduce the vendor sharkl5pro BSP PLL state read back
+	 * from the working Android kernel (lpf_sel = 0; regs 0x07/0x0c/0x0d = 0,
+	 * i.e. no spread spectrum). The mainline defaults (lpf_sel = 1 and reset
+	 * values 0x04/0x02/0x8a) leave the data lanes parked (PHY_STATUS 0x1f32).
+	 */
+	if (of_machine_is_compatible("anbernic,rg405m"))
+		reg_val[0] &= ~BIT(2);
+
 	for (i = 0; i < sizeof(reg_addr); ++i) {
 		regmap_write(regmap, reg_addr[i], reg_val[i]);
 		DRM_DEBUG("%02x: %02x\n", reg_addr[i], reg_val[i]);
 	}
+
+	if (of_machine_is_compatible("anbernic,rg405m")) {
+		regmap_write(regmap, 0x07, 0x00);
+		regmap_write(regmap, 0x0c, 0x00);
+		regmap_write(regmap, 0x0d, 0x00);
+	}
 }
 
 int dphy_pll_config(struct dsi_context *ctx)
