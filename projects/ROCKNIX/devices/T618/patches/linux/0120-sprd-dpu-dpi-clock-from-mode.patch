From: RG405M bring-up <rg405m@localhost>
Subject: [PATCH] drm/sprd: dpu: set the DPI pixel clock from the display mode (RG405M 25.6 MHz)

---
--- a/drivers/gpu/drm/sprd/sprd_dpu.c
+++ b/drivers/gpu/drm/sprd/sprd_dpu.c
@@ -745,6 +745,15 @@
 				    struct drm_atomic_state *state)
 {
 	struct sprd_dpu *dpu = to_sprd_crtc(crtc);
+	struct dpu_context *ctx = &dpu->ctx;
+	const struct drm_display_mode *mode = &crtc->state->adjusted_mode;
+
+	if (ctx->dpi_clk && mode->clock) {
+		int ret = clk_set_rate(ctx->dpi_clk, mode->clock * 1000UL);
+
+		drm_info(crtc->dev, "dpi clk: requested %d kHz, got %lu Hz (ret %d)\n",
+			 mode->clock, clk_get_rate(ctx->dpi_clk), ret);
+	}
 
 	sprd_dpu_init(dpu);
 
@@ -947,7 +956,13 @@
 		return PTR_ERR(ctx->dpi_clk);
 	}
 	if (ctx->dpi_clk) {
-		int ret = clk_set_rate(ctx->dpi_clk, 38400000);
+		/*
+		 * Default only; sprd_crtc_atomic_enable() programs the real pixel
+		 * clock of the mode (RG405M: 25.6 MHz, RG Rotate: 38.4 MHz).
+		 */
+		unsigned long rate = of_machine_is_compatible("anbernic,rg405m") ?
+				     25600000 : 38400000;
+		int ret = clk_set_rate(ctx->dpi_clk, rate);
 
 		if (ret)
 			dev_warn(dev, "failed to set dpi clock rate: %d\n", ret);
