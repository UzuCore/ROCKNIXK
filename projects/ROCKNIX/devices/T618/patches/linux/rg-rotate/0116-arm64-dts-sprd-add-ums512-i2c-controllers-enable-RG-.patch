From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Noxwell <beebono@yahoo.com>
Date: Mon, 29 Jun 2026 04:05:18 -0500
Subject: [PATCH 116/225] arm64: dts: sprd: add ums512 i2c controllers; enable
 RG Rotate charger

Port the i2c0..i2c4 controller nodes into ums512.dtsi under apb@70000000.
Upstream's apb bus already uses the offset child-address ranges scheme
that our 6.16 ap-apb fix had to add by hand, so i2c4 lands at the correct
0x00700000 with no bus rework needed.

On the RG Rotate board, wire the i2c4 pinmux (SIMCLK2/SIMDA2 at AF1 with
pull-ups; "func2" == AF1) and the AW32257 charger@6a, driven by the
mainline bq2415x driver as a bq24158. Enable I2C_SPRD and
CHARGER_BQ2415X in ums512_defconfig.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts | 56 +++++++++++++--
 arch/arm64/boot/dts/sprd/ums512.dtsi          | 70 +++++++++++++++++++
 arch/arm64/configs/ums512_defconfig           |  2 +
 3 files changed, 124 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts b/arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts
index 905a3fd91..93d08aec8 100644
--- a/arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts
+++ b/arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts
@@ -119,6 +119,53 @@ &sc2730_fgu {
 	sprd,calib-resistance-micro-ohms = <10000>;
 };
 
+/*
+ * i2c4 SCL/SDA are routed onto the SIMCLK2 / SIMDA2 pads at AF1 with internal
+ * pull-ups (source: vendor u-boot ums512_1h10 pinmap). UMS512 has no dedicated
+ * SCL4/SDA4 pads and the stock pinmux lived in the neutralized dtbo, so it must
+ * be set here or the bus never toggles. NB: sprd DT function naming is
+ * 1-indexed vs the AF number (sprd_pmx_set_mux maps "func2" -> AF1), so I2C4 =
+ * "func2". (memory: charger-aw32257-i2c4-blocker)
+ */
+&pinctrl {
+	i2c4_pin_func: i2c4-pin-func {
+		pins = "UMS512_SIMCLK2", "UMS512_SIMDA2";
+		function = "func2";
+	};
+
+	i2c4_pin_misc: i2c4-pin-misc {
+		pins = "UMS512_SIMCLK2_MISC", "UMS512_SIMDA2_MISC";
+		/* 4700 => WPUS|WPU, matching the u-boot pinmap (strong pull for
+		 * the open-drain i2c lines). */
+		bias-pull-up = <4700>;
+	};
+};
+
+/*
+ * Battery charger. Stock uses an AW32257 (Awinic) at i2c4 0x6a, a register
+ * clone of the TI bq24157/bq24158 — drive it with the mainline bq2415x driver.
+ * Values from the stock dtbo overlay (charger@6a), converted to bq2415x units.
+ */
+&i2c4 {
+	status = "okay";
+	clock-frequency = <400000>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c4_pin_func &i2c4_pin_misc>;
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	charger@6a {
+		compatible = "ti,bq24158";
+		reg = <0x6a>;
+		ti,current-limit = <1800>;
+		ti,weak-battery-voltage = <3400>;
+		ti,battery-regulation-voltage = <4200>;
+		ti,charge-current = <2000>;
+		ti,termination-current = <200>;
+		ti,resistor-sense = <33>;
+	};
+};
+
 /*
  * ===========================================================================
  * STAGED — blocked on SoC nodes not yet present in upstream 7.1 ums512.dtsi.
@@ -132,10 +179,11 @@ &sc2730_fgu {
  *       6.16). Configs: PINCTRL_SPRD_UMS512, GPIO_SPRD, GPIO_EIC_SPRD.
  *       (ums9230 pinctrl data does NOT cover ums512 pins — own driver kept.)
  *
- * [ ] ap-apb ranges + i2c4 addressing  (memory: charger-aw32257-i2c4-blocker)
- *       SoC-level: apapb `ranges;` identity + offset child addrs so i2c4
- *       lands at 0x00700000. Then board: i2c4 pinmux on SIMCLK2/SIMDA2
- *       (func2/AF1, WPU) + charger@6a "ti,bq24158".
+ * [x] i2c + charger  — DONE. Ported i2c0..i2c4 controllers into ums512.dtsi
+ *       apb@70000000 (offset addrs; upstream's apb bus ALREADY uses the
+ *       offset-range scheme our 6.16 fix had to add, so i2c4 lands at
+ *       0x00700000 for free). i2c4 pinmux + charger@6a un-staged above.
+ *       (memory: charger-aw32257-i2c4-blocker)
  *
  * [ ] USB  (memory: usb-gadget-otg-and-cleanup)  needs hsphy + usb SoC nodes.
  *       board: &hsphy phy-supply=<&vddusb33>; &usb dr_mode="otg" (MUST).
diff --git a/arch/arm64/boot/dts/sprd/ums512.dtsi b/arch/arm64/boot/dts/sprd/ums512.dtsi
index ceda12448..b3a0893c4 100644
--- a/arch/arm64/boot/dts/sprd/ums512.dtsi
+++ b/arch/arm64/boot/dts/sprd/ums512.dtsi
@@ -845,6 +845,76 @@ uart1: serial@100000 {
 				status = "disabled";
 			};
 
+			i2c0: i2c@300000 {
+				compatible = "sprd,ums512-i2c", "sprd,sc9860-i2c";
+				reg = <0x300000 0x100>;
+				interrupts = <GIC_SPI 11 IRQ_TYPE_LEVEL_HIGH>;
+				clock-frequency = <400000>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+				clock-names = "enable", "i2c", "source";
+				clocks = <&apapb_gate CLK_I2C0_EB>,
+					 <&ap_clk CLK_AP_I2C0>,
+					 <&ext_26m>;
+				status = "disabled";
+			};
+
+			i2c1: i2c@400000 {
+				compatible = "sprd,ums512-i2c", "sprd,sc9860-i2c";
+				reg = <0x400000 0x100>;
+				interrupts = <GIC_SPI 12 IRQ_TYPE_LEVEL_HIGH>;
+				clock-frequency = <400000>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+				clock-names = "enable", "i2c", "source";
+				clocks = <&apapb_gate CLK_I2C1_EB>,
+					 <&ap_clk CLK_AP_I2C1>,
+					 <&ext_26m>;
+				status = "disabled";
+			};
+
+			i2c2: i2c@500000 {
+				compatible = "sprd,ums512-i2c", "sprd,sc9860-i2c";
+				reg = <0x500000 0x100>;
+				interrupts = <GIC_SPI 13 IRQ_TYPE_LEVEL_HIGH>;
+				clock-frequency = <400000>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+				clock-names = "enable", "i2c", "source";
+				clocks = <&apapb_gate CLK_I2C2_EB>,
+					 <&ap_clk CLK_AP_I2C2>,
+					 <&ext_26m>;
+				status = "disabled";
+			};
+
+			i2c3: i2c@600000 {
+				compatible = "sprd,ums512-i2c", "sprd,sc9860-i2c";
+				reg = <0x600000 0x100>;
+				interrupts = <GIC_SPI 14 IRQ_TYPE_LEVEL_HIGH>;
+				clock-frequency = <400000>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+				clock-names = "enable", "i2c", "source";
+				clocks = <&apapb_gate CLK_I2C3_EB>,
+					 <&ap_clk CLK_AP_I2C3>,
+					 <&ext_26m>;
+				status = "disabled";
+			};
+
+			i2c4: i2c@700000 {
+				compatible = "sprd,ums512-i2c", "sprd,sc9860-i2c";
+				reg = <0x700000 0x100>;
+				interrupts = <GIC_SPI 15 IRQ_TYPE_LEVEL_HIGH>;
+				clock-frequency = <400000>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+				clock-names = "enable", "i2c", "source";
+				clocks = <&apapb_gate CLK_I2C4_EB>,
+					 <&ap_clk CLK_AP_I2C4>,
+					 <&ext_26m>;
+				status = "disabled";
+			};
+
 			sdio0: mmc@1100000 {
 				compatible = "sprd,sdhci-r11";
 				reg = <0x1100000 0x1000>;
diff --git a/arch/arm64/configs/ums512_defconfig b/arch/arm64/configs/ums512_defconfig
index bc2d22323..413c1906f 100644
--- a/arch/arm64/configs/ums512_defconfig
+++ b/arch/arm64/configs/ums512_defconfig
@@ -563,6 +563,7 @@ CONFIG_I2C_RK3X=y
 CONFIG_I2C_RZV2M=m
 CONFIG_I2C_S3C2410=y
 CONFIG_I2C_SH_MOBILE=y
+CONFIG_I2C_SPRD=y
 CONFIG_I2C_TEGRA=y
 CONFIG_I2C_UNIPHIER_F=y
 CONFIG_I2C_XILINX=m
@@ -727,6 +728,7 @@ CONFIG_BATTERY_SBS=m
 CONFIG_BATTERY_BQ27XXX=y
 CONFIG_BATTERY_MAX17042=m
 CONFIG_CHARGER_MT6360=m
+CONFIG_CHARGER_BQ2415X=m
 CONFIG_CHARGER_BQ25890=m
 CONFIG_CHARGER_BQ25980=m
 CONFIG_CHARGER_RK817=m
