+		frame-inversion;
+		sprd,fixed-fmt = <24>;
+
+		codec {
+			sound-dai = <&dig_codec 0>, <&sc2730_codec 0>;
+		};
+	};
+
+	iis1-dai-link {
+		link-name = "IIS1";
+		dai-format = "i2s";
+		frame-inversion;
+		sprd,fixed-fmt = <24>;
+
+		codec {
+			sound-dai = <&dig_codec 1>, <&sc2730_codec 1>;
+		};
