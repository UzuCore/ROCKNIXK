+
+	sys_keys: gpio-keys-system {
+		compatible = "gpio-keys";
+		pinctrl-names = "default";
+		pinctrl-0 = <&hall_pin_func &hall_pin_misc &volup_pin_func &volup_pin_misc>;
+
+		sw-hall {
+			label = "Hall Swivel";
+			linux,input-type = <EV_SW>;
+			linux,code = <SW_LID>;
+			gpios = <&ap_gpio 54 GPIO_ACTIVE_LOW>;
+			debounce-interval = <10>;
+			wakeup-source;
+			/*
+			 * Wake on open only. The gpio is active-low and
+			 * asserted means closed, so DEASSERTED is the
+			 * opening edge; gpio-keys retypes the irq to that
+			 * single edge for the duration of suspend. Without
+			 * this the trigger stays EDGE_BOTH and closing the
+			 * swivel wakes a device that was put to sleep with
+			 * the power key.
+			 */
+			wakeup-event-action = <EV_ACT_DEASSERTED>;
+		};
+		key-volumedown {
+			label = "Volume Down Key";
+			linux,code = <KEY_VOLUMEDOWN>;
+			gpios = <&pmic_eic 4 GPIO_ACTIVE_HIGH>;
+			debounce-interval = <2>;
+		};
+		key-volumeup {
+			label = "Volume Up Key";
+			linux,code = <KEY_VOLUMEUP>;
+			gpios = <&ap_gpio 30 GPIO_ACTIVE_LOW>;
+			debounce-interval = <2>;
+		};
+		key-power {
+			label = "Power Key";
+			linux,code = <KEY_POWER>;
+			gpios = <&pmic_eic 1 GPIO_ACTIVE_LOW>;
+			debounce-interval = <2>;
+			wakeup-source;
+		};
+	};
