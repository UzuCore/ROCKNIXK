+		btn-tl2 {
+			label = "BTN-TL2";
+			linux,code = <BTN_TL2>;
+			gpios = <&ap_gpio 3 GPIO_ACTIVE_LOW>;
+			debounce-interval = <2>;
+		};
+		btn-tr2 {
+			label = "BTN-TR2";
+			linux,code = <BTN_TR2>;
+			gpios = <&ap_gpio 2 GPIO_ACTIVE_LOW>;
+			debounce-interval = <2>;
+		};
+		btn-select {
+			label = "BTN-SELECT";
+			linux,code = <BTN_SELECT>;
+			gpios = <&ap_gpio 55 GPIO_ACTIVE_LOW>;
+			debounce-interval = <2>;
+		};
+		btn-start {
+			label = "BTN-START";
+			linux,code = <BTN_START>;
+			gpios = <&ap_gpio 87 GPIO_ACTIVE_LOW>;
+			debounce-interval = <2>;
+		};
+		btn-mode {
+			label = "BTN-MODE";
+			linux,code = <BTN_MODE>;
+			gpios = <&ap_gpio 124 GPIO_ACTIVE_LOW>;
+			debounce-interval = <2>;
+		};
+		btn-thumbr {
+			label = "BTN-THUMBR";
