+		i2c7 = &aon_i2c0;
+	};
+
+	chosen {
+		stdout-path = "serial1:115200n8";
+
+		framebuffer {
+			compatible = "simple-framebuffer";
+			memory-region = <&framebuffer_region>;
+			width = <720>;
+			height = <1600>;
+			stride = <(720 * 4)>;
+			format = "a8r8g8b8";
+
+			status = "disabled"; /* display driver is enabled */
