--- /dev/null
+++ b/arch/arm64/boot/dts/sprd/ums9230.dtsi
@@ -0,0 +1,2295 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Unisoc UMS9230 DTS file
