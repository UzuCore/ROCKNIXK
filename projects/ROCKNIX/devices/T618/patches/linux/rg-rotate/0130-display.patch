+struct icnl9916_panel {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct reset_control *reset;
+};
+
+static inline
+struct icnl9916_panel *to_icnl9916_panel(struct drm_panel *panel)
+{
