From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Noxwell <beebono@yahoo.com>
Date: Thu, 6 Aug 2026 17:47:00 -0500
Subject: [PATCH 218/225] arm64: dts: ums512: wire stock pmsys sipc channels
 5/6/41

Stock's sipc-pmsys declares spipe_pm(4), slog_pm(5), sctl_pm(6),
data0_gnss(7) and stime_pm(41); we only carried channel 4 (as shub,
wire-identical to stock's spipe_pm sbuf geometry). Add the missing
sbuf channels with stock buffer geometry: slog_pm rx-only 0x500 (the
SP firmware's own console log), sctl_pm 0x40/0x20, stime_pm 0x40/0x80.
data0_gnss is left out for now (GNSS pipe, large DDR buffers).

pm_sys may gate parts of its runtime - possibly the DFS/voltage
servicing - on these channels opening; slog_pm also finally lets us
read the firmware's boot log to see what its DVFS service reports.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/sprd/ums512.dtsi | 52 ++++++++++++++++++++++++++++
 1 file changed, 52 insertions(+)

diff --git a/arch/arm64/boot/dts/sprd/ums512.dtsi b/arch/arm64/boot/dts/sprd/ums512.dtsi
index b5c5fef55..1cc012fbd 100644
--- a/arch/arm64/boot/dts/sprd/ums512.dtsi
+++ b/arch/arm64/boot/dts/sprd/ums512.dtsi
@@ -586,6 +586,58 @@ rpmsg@1 {
 					};
 				};
 
+				/*
+				 * pm_sys console log, stock's "slog_pm".
+				 * Receive-only; the rx ring carries the SP
+				 * firmware's own printf output.
+				 */
+				channel@5 {
+					reg = <5>;
+					sprd,channel-type = "sbuf";
+					sprd,channel-name = "slog_pm";
+					#address-cells = <1>;
+					#size-cells = <1>;
+					sprd,tx-buf-size = <0x0>;
+					sprd,rx-buf-size = <0x500>;
+
+					rpmsg@0 {
+						reg = <0>, <0>;
+						sprd,channel-name = "slog_pm";
+					};
+				};
+
+				/* Sleep/power control pipe, stock's "sctl_pm". */
+				channel@6 {
+					reg = <6>;
+					sprd,channel-type = "sbuf";
+					sprd,channel-name = "sctl_pm";
+					#address-cells = <1>;
+					#size-cells = <1>;
+					sprd,tx-buf-size = <0x20>;
+					sprd,rx-buf-size = <0x40>;
+
+					rpmsg@0 {
+						reg = <0>, <0>;
+						sprd,channel-name = "sctl_pm";
+					};
+				};
+
+				/* AP time sync to the SP, stock's "stime_pm". */
+				channel@29 {
+					reg = <41>;
+					sprd,channel-type = "sbuf";
+					sprd,channel-name = "stime_pm";
+					#address-cells = <1>;
+					#size-cells = <1>;
+					sprd,tx-buf-size = <0x80>;
+					sprd,rx-buf-size = <0x40>;
+
+					rpmsg@0 {
+						reg = <0>, <0>;
+						sprd,channel-name = "stime_pm";
+					};
+				};
+
 				/*
 				 * Raw smsg control channel to the pm_sys DFS
 				 * task (vendor SMSG_CH_PM_CTRL). No shared
