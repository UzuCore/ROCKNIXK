From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Noxwell <beebono@yahoo.com>
Date: Mon, 13 Jul 2026 09:51:42 -0500
Subject: [PATCH 166/225] arm64: dts: sprd: ums512-rg-rotate: enable GT911
 touchscreen

---
 arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts | 110 +++++++++---------
 arch/arm64/configs/ums512_defconfig           |   1 +
 2 files changed, 58 insertions(+), 53 deletions(-)

diff --git a/arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts b/arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts
index 408d448e1..ab5c18cfe 100644
--- a/arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts
+++ b/arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts
@@ -88,6 +88,19 @@ lcd_avee: regulator-lcd-avee {
 		regulator-boot-on;
 	};
 
+	/*
+	 * Touch panel power. Stock exposes this as a raw vcc-gpios line on the
+	 * goodix node (ap_gpio 16); mainline goodix.c wants a regulator, not a
+	 * GPIO toggle, so it's wrapped as a fixed regulator instead.
+	 */
+	touch_vdd: regulator-touch-vdd {
+		compatible = "regulator-fixed";
+		regulator-name = "touch-vdd";
+		gpio = <&ap_gpio 16 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-boot-on;
+	};
+
 	/*
 	 * Gamepad. Stock uses the out-of-tree "singleadc-joypad" driver, which
 	 * bundled these GPIO buttons with an ADC stick path (6-way amux +
@@ -463,31 +476,6 @@ hall_pin_misc: hall-pin-misc {
 	};
 };
 
-/*
- * Battery charger. Stock uses an AW32257 (Awinic) at i2c4 0x6a, a register
- * clone of the TI bq24157/bq24158. Values have been translated from the
- * stock dtbo overlay (charger@6a) to bq2415x units.
- */
-&i2c4 {
-	status = "okay";
-	clock-frequency = <400000>;
-	pinctrl-names = "default";
-	pinctrl-0 = <&i2c4_pin_func &i2c4_pin_misc>;
-	#address-cells = <1>;
-	#size-cells = <0>;
-
-	charger@6a {
-		compatible = "ti,bq24158";
-		reg = <0x6a>;
-		ti,current-limit = <1800>;
-		ti,weak-battery-voltage = <3400>;
-		ti,battery-regulation-voltage = <4200>;
-		ti,charge-current = <2000>;
-		ti,termination-current = <200>;
-		ti,resistor-sense = <33>;
-	};
-};
-
 &iommu_disp {
 	status = "okay";
 };
@@ -723,40 +711,56 @@ speaker_amp: audio-codec@58 {
 };
 
 /*
- * AP-side i2s0 audio path (all-i2s test card). Brought up to extend the
- * vendor audio port beyond the working VBC/agcp card. Rides ap_dma (its
- * own AP-owned DMA + GIC_SPI 24), so it should get native DMA period
- * interrupts rather than the hrtimer workaround the VBC path needs.
- *
- * i2s0 is configured for the stock PCM/BT-SCO mode (bus_type=1, 8 kHz,
- * short frame). Adjust sprd,config_type/bus_type for raw i2s use.
+ * Touchscreen. Stock uses a Goodix GT911 (paired with the lcd_gt911_mipi_ab021
+ * panel; 186-byte cfg-group0 matches the smaller GT911-class config) behind
+ * the generic "goodix,gt9xx" downstream driver on i2c3. Config is read back
+ * from the chip over i2c by the mainline driver, so the vendor cfg-group0
+ * blob and all goodix,* tuning props are dropped; only irq/reset gpios and a
+ * supply are needed.
  */
-&ap_dma {
+&i2c3 {
 	status = "okay";
+	clock-frequency = <400000>;
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	touchscreen@14 {
+		compatible = "goodix,gt911";
+		reg = <0x14>;
+		AVDD28-supply = <&touch_vdd>;
+		VDDIO-supply = <&touch_vdd>;
+		irq-gpios = <&ap_gpio 144 GPIO_ACTIVE_HIGH>;
+		reset-gpios = <&ap_gpio 145 GPIO_ACTIVE_HIGH>;
+		touchscreen-size-x = <720>;
+		touchscreen-size-y = <720>;
+		touchscreen-inverted-x;
+		touchscreen-inverted-y;
+	};
 };
 
-&i2s0 {
-	sprd,config_type = "pcm";
-	sprd,slave_timeout = <0xF11>;
-	sprd,fs = <8000>;
-	sprd,bus_type = <1>;
-	sprd,rtx_mode = <3>;
-	sprd,byte_per_chan = <1>;
-	sprd,slave_mode = <0>;
-	sprd,lsb = <0>;
-	sprd,lrck = <0>;
-	sprd,low_for_left = <1>;
-	sprd,clk_inv = <0>;
-	sprd,pcm_short_frame = <1>;
-	sprd,pcm_slot = <0x1>;
-	sprd,pcm_cycle = <1>;
-	sprd,tx_watermark = <12>;
-	sprd,rx_watermark = <20>;
+/*
+ * Battery charger. Stock uses an AW32257 (Awinic) at i2c4 0x6a, a register
+ * clone of the TI bq24157/bq24158. Values have been translated from the
+ * stock dtbo overlay (charger@6a) to bq2415x units.
+ */
+&i2c4 {
 	status = "okay";
-};
+	clock-frequency = <400000>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c4_pin_func &i2c4_pin_misc>;
+	#address-cells = <1>;
+	#size-cells = <0>;
 
-&sound_sprd_ap_alliis {
-	status = "disabled";
+	sc2730_charger: charger@6a {
+		compatible = "ti,bq24158";
+		reg = <0x6a>;
+		ti,current-limit = <1800>;
+		ti,weak-battery-voltage = <3400>;
+		ti,battery-regulation-voltage = <4200>;
+		ti,charge-current = <2000>;
+		ti,termination-current = <200>;
+		ti,resistor-sense = <33>;
+	};
 };
 
 &sdio0 {
diff --git a/arch/arm64/configs/ums512_defconfig b/arch/arm64/configs/ums512_defconfig
index 0f7fbfa77..7b3462196 100644
--- a/arch/arm64/configs/ums512_defconfig
+++ b/arch/arm64/configs/ums512_defconfig
@@ -572,6 +572,7 @@ CONFIG_SND_SOC_LPASS_TX_MACRO=m
 CONFIG_SND_SIMPLE_CARD=m
 CONFIG_SND_AUDIO_GRAPH_CARD=m
 CONFIG_SND_AUDIO_GRAPH_CARD2=m
+CONFIG_TOUCHSCREEN_GOODIX=y
 CONFIG_HID_A4TECH=y
 CONFIG_HID_APPLE=y
 CONFIG_HID_BELKIN=y
