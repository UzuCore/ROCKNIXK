 	interrupt-parent = <&gic>;
@@ -31,6 +32,123 @@ aliases {
 		i2c4 = &i2c4;
 	};
 
+	/*
+	 * Cache-efuse shadow: the boot ROM/SPL pre-populates a fixed-address
+	 * DRAM shadow of the real efuse array at physical 0x800, which is how
+	 * the thermal sensors read their per-chip calibration cells. This is
+	 * a fixed SoC-level physical location (not a board carveout), so it
+	 * lives here rather than in a board dts reserved-memory override -
+	 * unlike the audio regions below, no board needs to supply this.
+	 * (memory: thermal-cpufreq-bringup)
+	 */
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		nvmem@800 {
+			compatible = "sprd,ums512-cache-efuse", "nvmem-rmem";
+			reg = <0 0x800 0 0x3ff>;
+			no-map;
+
+			nvmem-layout {
+				compatible = "fixed-layout";
+				#address-cells = <1>;
+				#size-cells = <1>;
+
+				thm0_sign: thm0-sign@38 {
+					reg = <0x38 0x1>;
+					bits = <0 1>;
+				};
+
+				thm0_ratio: thm0-ratio@38 {
+					reg = <0x38 0x1>;
+					bits = <1 7>;
+				};
+
+				thm0_sen0: thm0-sen0@39 {
+					reg = <0x39 0x1>;
+					bits = <0 8>;
+				};
+
+				thm0_sen1: thm0-sen1@41 {
+					reg = <0x41 0x1>;
+					bits = <0 8>;
+				};
+
+				thm0_sen2: thm0-sen2@40 {
+					reg = <0x40 0x1>;
+					bits = <0 8>;
+				};
+
+				thm0_sen3: thm0-sen3@43 {
+					reg = <0x43 0x1>;
+					bits = <0 8>;
+				};
+
+				thm0_sen4: thm0-sen4@42 {
+					reg = <0x42 0x1>;
+					bits = <0 8>;
+				};
+
+				thm1_sign: thm1-sign@3c {
+					reg = <0x3c 0x1>;
+					bits = <0 1>;
+				};
+
+				thm1_ratio: thm1-ratio@3c {
+					reg = <0x3c 0x1>;
+					bits = <1 7>;
+				};
+
+				thm1_sen0: thm1-sen0@3d {
+					reg = <0x3d 0x1>;
+					bits = <0 8>;
+				};
+
+				thm1_sen1: thm1-sen1@2f {
+					reg = <0x2f 0x1>;
+					bits = <0 8>;
+				};
+
+				thm1_sen2: thm1-sen2@2e {
+					reg = <0x2e 0x1>;
+					bits = <0 8>;
+				};
+
+				thm1_sen3: thm1-sen3@29 {
