 drivers/net/wireless/unisoc/protocol.h |  14 +-
 drivers/net/wireless/unisoc/sc23xx.h   |  26 ++++
 drivers/net/wireless/unisoc/sdio.c     | 183 +++++++++++++++++++------
 drivers/net/wireless/unisoc/txrx.c     |  27 ++--
 5 files changed, 232 insertions(+), 61 deletions(-)

