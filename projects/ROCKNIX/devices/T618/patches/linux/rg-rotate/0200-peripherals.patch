+	SPRD_ISP_INPUT,
+	SPRD_ISP_OUTPUT,
+	SPRD_ISP_NUM_NODES
+};
+
+struct sprd_isp_ctx {
+	struct v4l2_subdev sd;
+	struct media_pad pad[SPRD_ISP_NUM_NODES];
+
+	struct sprd_isp_config_node config;
+	struct sprd_isp_video_node input;
+	struct sprd_isp_video_node output;
+
+	struct v4l2_rect crop_rect;
