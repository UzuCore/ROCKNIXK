+#define CSI_PHY_SEL					0x0070
+#define CSI_CPHY_ERR2					0x0074
+#define CSI_CPHY_ERR2_MASK				0x0078
+#define CSI_CPHY_ERR2_CLR				0x007C
+#define CSI_PHY_TRANS_FLAG				0x0080
+#define CSI_PHY_PH_ERR_NUM				0x0084
