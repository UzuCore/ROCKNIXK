+#define CSI_IPG_RAW10_CFG2				0x0058
+#define CSI_IPG_RAW10_CFG3				0x005C
+#define CSI_IPG_YUV422_8_CFG0				0x0060
+#define CSI_IPG_YUV422_8_CFG4				0x0064
