From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Noxwell <beebono@yahoo.com>
Date: Sun, 12 Jul 2026 17:19:20 -0500
Subject: [PATCH 163/225] arm64: dts: sprd: ums512-rg-rotate: enable eic,
 improve sdio, use all 3GB of RAM

---
 arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts | 105 +++++++++---------
 arch/arm64/boot/dts/sprd/ums512.dtsi          |  53 +++++++++
 2 files changed, 103 insertions(+), 55 deletions(-)

diff --git a/arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts b/arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts
index 381ed89f0..e0883ad58 100644
--- a/arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts
+++ b/arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts
@@ -25,7 +25,7 @@ aliases {
 
 	memory@80000000 {
 		device_type = "memory";
-		reg = <0x0 0x80000000 0x0 0x80000000>;
+		reg = <0x0 0x80000000 0x0 0xC0000000>;
 	};
 
 	chosen {
@@ -168,34 +168,6 @@ dvfs_dcdc_cpu1_supply: dvfs-dcdc-cpu1-supply {
 	};
 };
 
-&sdio0 {
-	status = "okay";
-	vmmc-supply = <&vddsdcore>;
-	vqmmc-supply = <&vddsdio>;
-	bus-width = <4>;
-	no-sdio;
-	no-mmc;
-	broken-cd;
-	non-removable;
-	sprd,phy-delay-sd-uhs-sdr104 = <0x7f 0x73 0x72 0x72>;
-	sprd,phy-delay-sd-uhs-sdr50 = <0x6e 0x7f 0x01 0x01>;
-	sprd,phy-delay-sd-highspeed = <0x7f 0x1a 0x9a 0x9a>;
-	sprd,phy-delay-legacy = <0x7f 0x1a 0x9a 0x9a>;
-	sd-uhs-sdr104;
-	sd-uhs-sdr50;
-};
-
-/* eMMC. vmmc-supply keeps the core rail up without regulator_ignore_unused. */
-&sdio3 {
-	status = "okay";
-	vmmc-supply = <&vddemmccore>;
-	bus-width = <8>;
-	no-sdio;
-	no-sd;
-	non-removable;
-	cap-mmc-hw-reset;
-};
-
 /* SC2730 fuel gauge — battery voltage / capacity reporting. */
 &sc2730_fgu {
 	status = "okay";
@@ -236,6 +208,11 @@ i2c4_pin_misc: i2c4-pin-misc {
 		 * the open-drain i2c lines). */
 		bias-pull-up = <4700>;
 	};
+
+    sd0_cd: sd0-cd {
+        pins = "UMS512_RFFE1_SDA";
+        function = "func4";
+    };
 };
 
 /*
@@ -532,7 +509,42 @@ &i2s0 {
 
 &sound_sprd_ap_alliis {
 	status = "disabled";
-	sprd,syscon-agcp-ahb = <&aon_apb_regs>;
+};
+
+&sdio0 {
+	status = "okay";
+	vmmc-supply = <&vddsdcore>;
+	vqmmc-supply = <&vddsdio>;
+	cd-gpios = <&eic_sync 19 GPIO_ACTIVE_LOW>;
+	bus-width = <4>;
+	sprd,phy-delay-sd-uhs-sdr104 = <0x7f 0x73 0x72 0x72>;
+	sprd,phy-delay-sd-uhs-sdr50 = <0x6e 0x7f 0x01 0x01>;
+	sprd,phy-delay-sd-highspeed = <0x7f 0x1a 0x9a 0x9a>;
+	sprd,phy-delay-legacy = <0x7f 0x1a 0x9a 0x9a>;
+	sd-uhs-sdr104;
+	sd-uhs-sdr50;
+	no-sdio;
+	no-mmc;
+};
+
+&sdio3 {
+	status = "disabled";
+	vmmc-supply = <&vddemmccore>;
+	bus-width = <8>;
+	voltage-ranges = <3000 3000>;
+	non-removable;
+	cap-mmc-hw-reset;
+	sprd,phy-delay-mmc-hs400es = <0x40 0x7f 0x2d 0x2d>;
+	sprd,phy-delay-mmc-hs400 = <0x3f 0xdf 0x2f 0x2f>;
+	sprd,phy-delay-mmc-hs200 = <0x7f 0xde 0xd4 0xd4>;
+	sprd,phy-delay-mmc-ddr52 = <0x3e 0x37 0x24 0x24>;
+	sprd,phy-delay-mmc-highspeed = <0x60 0xb7 0x34 0x34>;
+	mmc-hs400-enhanced-strobe;
+	mmc-hs400-1_8v;
+	mmc-hs200-1_8v;
+	mmc-ddr-1_8v;
+	no-sdio;
+	no-sd;
 };
 
 /*
@@ -544,27 +556,12 @@ &sound_sprd_ap_alliis {
 &sdio1 {
 	status = "okay";
 	bus-width = <4>;
-	no-sd;
-	no-mmc;
-	/*
-	 * Must stay REMOVABLE: the marlin core powers the WCN chip and then
-	 * forces an explicit card rescan (mmc_detect_change via the extcon
-	 * link) so the SDIO function enumerates; sdiohal sets
-	 * MMC_CAP_NONREMOVABLE at runtime only while the card is up, and
-	 * clears it on power-off. A DT "non-removable" makes the mmc core try
-	 * to init a card at boot while the chip is unpowered ("Failed to
-	 * initialize a non-removable card") and defeats the rescan handoff.
-	 * (The CMD5 poll storm on the empty slot when the chip is off is a
-	 * cosmetic dead-chip artifact; do not "fix" it by marking this host
-	 * non-removable.)
-	 */
-	cap-sdio-irq;
-	keep-power-in-suspend;
-	/* PHY tuning from the vendor ums512-1h10 overlay (WCN SDIO). */
 	sprd,phy-delay-sd-uhs-sdr104 = <0x7f 0x76 0x69 0x69>;
 	sprd,phy-delay-sd-uhs-sdr50 = <0x7f 0xf7 0xf5 0xf5>;
 	sd-uhs-sdr104;
 	sd-uhs-sdr50;
+	no-sd;
+	no-mmc;
 };
 
 / {
@@ -583,14 +580,11 @@ sprd_marlin3: sprd-marlin3 {
 		reset-gpios = <&ap_gpio 95 GPIO_ACTIVE_LOW>;
 		m2-wakeup-ap-gpios = <&ap_gpio 33 GPIO_ACTIVE_LOW>;
 		m2-to-ap-irq-gpios = <&ap_gpio 94 GPIO_ACTIVE_LOW>;
-
-		avdd12-supply = <&vddwcn>;
-		avdd33-supply = <&vddwifipa>;
-		dcxo18-supply = <&vddsim2>;
+		adma-tx;
+		adma-rx;
 
 		clock-names = "clk_32k", "source", "enable";
-		clocks = <&aon_clk CLK_AUX0>,
-			 <&ext_32k>,
+		clocks = <&aon_clk CLK_AUX0>, <&ext_32k>,
 			 <&aonapb_gate CLK_AUX0_EB>;
 
 		extcon = <&sdio1>;
@@ -604,8 +598,9 @@ sprd_marlin3: sprd-marlin3 {
 		sprd,btwf-file-name = "/lib/firmware/wcnmodem.bin";
 		sprd,gnss-file-name = "/lib/firmware/gnssmodem.bin";
 
-		adma-tx;
-		adma-rx;
+		avdd12-supply = <&vddwcn>;
+		avdd33-supply = <&vddwifipa>;
+		dcxo18-supply = <&vddsim2>;
 
 		avdd12-parent-bound-chip = <REG_ANA_SLP_DCDC_PD_CTRL MASK_ANA_SLP_DCDCGEN1_PD_EN 0x0 MASK_ANA_SLP_DCDCGEN1_PD_EN>;
 		avdd12-bound-wbreq = <REG_ANA_LDO_XTL_EN10 MASK_ANA_LDO_VDDWCN_EXT_XTL3_EN 0x0 MASK_ANA_LDO_VDDWCN_EXT_XTL3_EN>;
diff --git a/arch/arm64/boot/dts/sprd/ums512.dtsi b/arch/arm64/boot/dts/sprd/ums512.dtsi
index 718c72aa0..14cfd6fb0 100644
--- a/arch/arm64/boot/dts/sprd/ums512.dtsi
+++ b/arch/arm64/boot/dts/sprd/ums512.dtsi
@@ -18,6 +18,7 @@ / {
 
 	aliases {
 		mmc0 = &sdio0;
+		mmc1 = &sdio1;
 		mmc3 = &sdio3;
 		i2c0 = &i2c0;
 		i2c1 = &i2c1;
@@ -1068,6 +1069,58 @@ power-domain@UMS512_POWER_DOMAIN_PUBCP {
 			};
 		};
 
+		eic_debounce: gpio@32000000 {
+			compatible = "sprd,sharkl5pro-eic-debounce", "sprd,sc9860-eic-debounce";
+			reg = <0 0x32020000 0 0x80>,
+			      <0 0x32030000 0 0x80>,
+			      <0 0x32230000 0 0x80>,
+			      <0 0x32270000 0 0x80>;
+			gpio-controller;
+			#gpio-cells = <2>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+			interrupts = <GIC_SPI 72 IRQ_TYPE_LEVEL_HIGH>;
+		};
+
+		eic_latch: gpio@32000080 {
+			compatible = "sprd,sharkl5pro-eic-latch", "sprd,sc9860-eic-latch";
+			reg = <0 0x32020080 0 0x20>,
+			      <0 0x32030080 0 0x20>,
+			      <0 0x32230080 0 0x20>,
+			      <0 0x32270080 0 0x20>;
+			gpio-controller;
+			#gpio-cells = <2>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+			interrupts = <GIC_SPI 72 IRQ_TYPE_LEVEL_HIGH>;
+		};
+
+		eic_async: gpio@320000a0 {
+			compatible = "sprd,sharkl5pro-eic-async", "sprd,sc9860-eic-async";
+			reg = <0 0x320200a0 0 0x20>,
+			      <0 0x320300a0 0 0x20>,
+			      <0 0x322300a0 0 0x20>,
+			      <0 0x322700a0 0 0x20>;
+			gpio-controller;
+			#gpio-cells = <2>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+			interrupts = <GIC_SPI 72 IRQ_TYPE_LEVEL_HIGH>;
+		};
+
+		eic_sync: gpio@320000c0 {
+			compatible = "sprd,sharkl5pro-eic-sync", "sprd,sc9860-eic-sync";
+			reg = <0 0x320200c0 0 0x20>,
+			      <0 0x320300c0 0 0x20>,
+			      <0 0x322300c0 0 0x20>,
+			      <0 0x322700c0 0 0x20>;
+			gpio-controller;
+			#gpio-cells = <2>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+			interrupts = <GIC_SPI 72 IRQ_TYPE_LEVEL_HIGH>;
+		};
+
 		audcp_apb_regs: syscon@3350d000 {
 			compatible = "sprd,ums512-glbregs", "syscon",
 				     "simple-mfd";
