From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Noxwell <beebono@yahoo.com>
Date: Thu, 23 Jul 2026 16:32:13 -0500
Subject: [PATCH 172/225] rg-rotate dts btn mapping tweaks

---
 arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts | 55 ++++++-------------
 1 file changed, 16 insertions(+), 39 deletions(-)

diff --git a/arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts b/arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts
index 7b6f64661..a90744e89 100644
--- a/arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts
+++ b/arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts
@@ -139,8 +139,6 @@ btn-y {
 			gpios = <&ap_gpio 113 GPIO_ACTIVE_LOW>;
 			debounce-interval = <2>;
 		};
-
-		/* Shoulders / triggers */
 		btn-tl {
 			label = "BTN-TL";
 			linux,code = <BTN_TL>;
@@ -177,51 +175,45 @@ btn-start {
 			gpios = <&ap_gpio 87 GPIO_ACTIVE_LOW>;
 			debounce-interval = <2>;
 		};
-		key-back {
-			label = "BACK";
-			linux,code = <KEY_BACK>;
+		btn-mode {
+			label = "BTN-MODE";
+			linux,code = <BTN_MODE>;
 			gpios = <&ap_gpio 124 GPIO_ACTIVE_LOW>;
 			debounce-interval = <2>;
 		};
-		key-f9 {
-			label = "F9";
-			linux,code = <KEY_F9>;
-			gpios = <&ap_gpio 125 GPIO_ACTIVE_LOW>;
-			debounce-interval = <2>;
-		};
-		key-f10 {
-			label = "F10";
-			linux,code = <KEY_F10>;
+		btn-thumbr {
+			label = "BTN-THUMBR";
+			linux,code = <BTN_THUMBR>;
 			gpios = <&ap_gpio 126 GPIO_ACTIVE_LOW>;
 			debounce-interval = <2>;
 		};
 	};
 
-	volume_keys: gpio-keys-volume {
+	sys_keys: gpio-keys-system {
 		compatible = "gpio-keys";
-		autorepeat;
 		pinctrl-names = "default";
-		pinctrl-0 = <&volup_pin_func &volup_pin_misc>;
+		pinctrl-0 = <&hall_pin_func &hall_pin_misc &volup_pin_func &volup_pin_misc>;
 
+		sw-hall {
+			label = "Hall Swivel";
+			linux,input-type = <EV_SW>;
+			linux,code = <SW_LID>;
+			gpios = <&ap_gpio 54 GPIO_ACTIVE_LOW>;
+			debounce-interval = <10>;
+			wakeup-source;
+		};
 		key-volumedown {
 			label = "Volume Down Key";
 			linux,code = <KEY_VOLUMEDOWN>;
 			gpios = <&pmic_eic 4 GPIO_ACTIVE_HIGH>;
 			debounce-interval = <2>;
-			wakeup-source;
 		};
 		key-volumeup {
 			label = "Volume Up Key";
 			linux,code = <KEY_VOLUMEUP>;
 			gpios = <&ap_gpio 30 GPIO_ACTIVE_LOW>;
 			debounce-interval = <2>;
-			wakeup-source;
 		};
-	};
-
-	sys_keys: gpio-keys-system {
-		compatible = "gpio-keys";
-
 		key-power {
 			label = "Power Key";
 			linux,code = <KEY_POWER>;
@@ -231,21 +223,6 @@ key-power {
 		};
 	};
 
-	hall_switch: gpio-keys-hall {
-		compatible = "gpio-keys";
-		pinctrl-names = "default";
-		pinctrl-0 = <&hall_pin_func &hall_pin_misc>;
-
-		hall {
-			label = "Hall Swivel";
-			linux,input-type = <EV_SW>;
-			linux,code = <SW_TABLET_MODE>;
-			gpios = <&ap_gpio 54 GPIO_ACTIVE_LOW>;
-			debounce-interval = <10>;
-			wakeup-source;
-		};
-	};
-
 	bat: battery {
 		compatible = "simple-battery";
 		charge-full-design-microamp-hours = <1900000>;
