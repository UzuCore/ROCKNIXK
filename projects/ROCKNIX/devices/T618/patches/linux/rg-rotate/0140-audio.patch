+	{
+		.name = "VBC_FE_CAPTURE_DSP",
+		.id = VBC_FE_CAPTURE_DSP,
+		.capture = {
+			.stream_name = "VBC_FE_CAPTURE_DSP Capture",
+			.channels_min = 2,
+			.channels_max = 2,
+			.rates = SPRD_PCM_RATES,
