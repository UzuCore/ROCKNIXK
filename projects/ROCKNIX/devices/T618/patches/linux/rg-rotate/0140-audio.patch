+/* NOTE: VB, BG & BIAS must be enabled before calling this function. */
+static void spk_pa_short_check(struct sprd_codec_priv *sprd_codec)
+{
+#ifdef SPRD_CODEC_IMPD
+	struct snd_soc_component *codec;
+
+	int val, mask;
+	u32 flag;
+
+	codec = sprd_codec ? sprd_codec->codec : NULL;
+	if (!codec)
+		return;
+
+	snd_soc_component_update_bits(codec, SOC_REG(ANA_CDC14), PA_EN, 0);
+	snd_soc_component_update_bits(codec, SOC_REG(ANA_CDC20),
+		PA_SHORTH_DET_EN, PA_SHORTH_DET_EN);
+	sprd_codec_wait(1);
+	flag = snd_soc_component_read(codec, SOC_REG(ANA_CDC14)) | PA_SHT_FLAG(0xFFFF);
+	if (flag) {
+		sprd_codec->pa_short_stat = PA_SHORT_VBAT;
+		return;
+	}
+	snd_soc_component_update_bits(codec, SOC_REG(ANA_CDC20),
+		PA_SHORTL_DET_EN, PA_SHORTL_DET_EN);
+	sprd_codec_wait(1);
+	flag = snd_soc_component_read(codec, SOC_REG(ANA_CDC14)) | PA_SHT_FLAG(0xFFFF);
+	if (flag) {
+		sprd_codec->pa_short_stat = PA_SHORT_GND;
+		return;
+	}
+
+	snd_soc_component_update_bits(codec, SOC_REG(ANA_DCL1),
+		DCL_EN, DCL_EN);
+	mask = ANA_CLK_EN | CLK_DIG_6M5_EN | CLK_DCL_6M5_EN | CLK_DCL_32K_EN;
+	snd_soc_component_update_bits(codec, SOC_REG(ANA_CLK0), mask, mask);
+	snd_soc_component_update_bits(codec, SOC_REG(ANA_DCL1),
+		DIG_CLK_IMPD_EN, DIG_CLK_IMPD_EN);
+	snd_soc_component_update_bits(codec, SOC_REG(ANA_CLK0),
+		CLK_IMPD_EN, CLK_IMPD_EN);
+
+
+	snd_soc_component_update_bits(codec, SOC_REG(ANA_CDC0),
+		PGA_ADC_IBIAS_EN, PGA_ADC_IBIAS_EN);
+	snd_soc_component_update_bits(codec, SOC_REG(ANA_PMU0),
+		VB_EN, VB_EN);
+
+	snd_soc_component_update_bits(codec, SOC_REG(ANA_CDC20),
+		PA_IMPD_DET_EN, PA_IMPD_DET_EN);
+	snd_soc_component_update_bits(codec, SOC_REG(ANA_DCL0),
+		RSTN_AUD_DIG_IMPD_ADC, RSTN_AUD_DIG_IMPD_ADC);
+
+	snd_soc_component_update_bits(codec, SOC_REG(ANA_IMPD0),
+		IMPD_ADC_EN, IMPD_ADC_EN);
+	snd_soc_component_update_bits(codec, SOC_REG(ANA_IMPD1),
+		IMPD_ADC_CLK_SEL(0xFFFF), 0);
+
+	mask = IMPD_BUF_EN | IMPD_CH_SEL(0xFFFF);
+	val = IMPD_BUF_EN | IMPD_CH_SEL(4);
+	snd_soc_component_update_bits(codec, SOC_REG(ANA_IMPD0),
+		mask, val);
+
+	mask = IMPD_TIME_CNT_SEL(0xFFFF) | IMPD_CUR_EN;
+	val = IMPD_TIME_CNT_SEL(5) | IMPD_CUR_EN;
+	snd_soc_component_update_bits(codec, SOC_REG(ANA_IMPD2),
+		mask, val);
+	sprd_codec_wait(60);
+
+	val = snd_soc_component_read(codec, SOC_REG(ANA_STS14)) | IMPD_ADC_DATO(0xFFFF);
+
+	/* yintang: TBD. calculate the impd per the val */
+#endif
+}
