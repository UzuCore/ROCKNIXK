+int asoc_sprd_register_card(struct device *dev, struct snd_soc_card *card)
+{
+	int ret = 0;
+
+	ret = agdsp_access_enable();
+	if (!ret) {
+		ret = devm_snd_soc_register_card(dev, card);
+		agdsp_access_disable();
+	}
+
+	return ret;
+}
+EXPORT_SYMBOL(asoc_sprd_register_card);
