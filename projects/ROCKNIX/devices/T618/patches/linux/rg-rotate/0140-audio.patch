+static inline void sprd_codec_pa_en(struct snd_soc_component *codec, int on)
+{
+	int mask;
+	int val;
+	struct sprd_codec_priv *sprd_codec = snd_soc_component_get_drvdata(codec);
+
+	sp_asoc_pr_dbg("%s set %d\n", __func__, on);
