+static int hifi_dsp_trigger(int scene_id, int stream, int up_down)
+{
+	int ret;
+
+	ret = hifi_func_trigger(scene_id, stream, up_down);
+	if (ret < 0) {
+		pr_err("vbc_dsp_func_trigger return error\n");
