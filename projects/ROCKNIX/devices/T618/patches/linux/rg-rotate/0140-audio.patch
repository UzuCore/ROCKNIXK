+/* unit: ms */
+static void sprd_codec_wait(u32 wait_time)
+{
+	pr_debug("%s %d ms\n", __func__, wait_time);
+
+	if (wait_time < 0)
+		return;
+	if (wait_time < 20)
+		usleep_range(wait_time * 1000, wait_time * 1000 + 200);
+	else
+		msleep(wait_time);
+}
