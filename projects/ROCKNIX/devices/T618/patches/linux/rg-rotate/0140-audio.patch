Subject: [PATCH] sprd: audio support for UMS512

Consolidated from beebono/linux-mainline-sprd rg-rotate 464b3e7bf45bb300e190339977abba36c8078e1f, rebased onto Linux 7.1.2.
Original authors and patch hashes are recorded in series-origin.json.

diff --git a/sound/soc/codecs/Kconfig b/sound/soc/codecs/Kconfig
index 269c31ce08143173abc996cc2936d2998c78351b..168f746a58324f16c09c16005e613c7106e1a4d5 100644
--- a/sound/soc/codecs/Kconfig
+++ b/sound/soc/codecs/Kconfig
@@ -245,6 +245,7 @@ config SND_SOC_ALL_CODECS
 	imply SND_SOC_RT9123
 	imply SND_SOC_RTQ9124
 	imply SND_SOC_RTQ9128
+	imply SND_SOC_SC2730
 	imply SND_SOC_SDW_MOCKUP
 	imply SND_SOC_SGTL5000
 	imply SND_SOC_SI476X
@@ -298,6 +299,7 @@ config SND_SOC_ALL_CODECS
 	imply SND_SOC_UDA1334
 	imply SND_SOC_UDA1342
 	imply SND_SOC_UDA1380
+	imply SND_SOC_UMS9230_DIGITAL
 	imply SND_SOC_WCD9335
 	imply SND_SOC_WCD934X
 	imply SND_SOC_WCD937X_SDW
@@ -2005,6 +2007,13 @@ config SND_SOC_RTQ9128
 	  To compile this driver as a module, choose M here: the module
 	  will be called snd-soc-rtq9128.
 
+config SND_SOC_SC2730
+	tristate "Spreadtrum SC2730 PMIC codec"
+	depends on MFD_SC27XX_PMIC || COMPILE_TEST
+	help
+	  This driver provides support for the integrated audio codec in
+	  the SC2730 PMIC.
+
 config SND_SOC_SDW_MOCKUP
 	tristate "SoundWire mockup codec"
 	depends on EXPERT
@@ -2376,6 +2385,11 @@ config SND_SOC_UDA1380
 	  The UDA1380 codec is used in the HTC Magician and on a number of
 	  Samsung reference boards, as well as the LPC32xx series.
 
+config SND_SOC_UMS9230_DIGITAL
+	tristate "UMS9230 Digital Codec"
+	depends on ARCH_SPRD || COMPILE_TEST
+	depends on REGMAP_MMIO
+
 config SND_SOC_WCD_CLASSH
 	tristate
 
