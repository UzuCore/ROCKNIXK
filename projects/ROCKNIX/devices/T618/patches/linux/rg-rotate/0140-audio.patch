+static struct snd_kcontrol *sprd_codec_find_ctrl(struct snd_soc_component *codec,
+						 char *name)
+{
+	struct snd_soc_card *card = codec ? codec->card : NULL;
+	struct snd_ctl_elem_id id = {.iface = SNDRV_CTL_ELEM_IFACE_MIXER};
+
+	if (!codec || !name)
+		return NULL;
+	memcpy(id.name, name, strlen(name));
+
+	return snd_ctl_find_id(card->snd_card, &id);
+}
