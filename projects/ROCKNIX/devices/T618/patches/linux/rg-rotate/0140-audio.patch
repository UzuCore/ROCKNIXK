+static int to_vbc_chan(int channels)
+{
+	int chan;
+
+	switch (channels) {
+	case 1:
+		chan = VBC_LEFT;
+		break;
+	case 2:
+		chan = VBC_ALL_CHAN;
+		break;
+	default:
+		chan = VBC_ALL_CHAN;
+		pr_err("channels is %d, default vbc channel =%d\n",
+			channels, chan);
+		break;
+	}
+
+	return chan;
+}
