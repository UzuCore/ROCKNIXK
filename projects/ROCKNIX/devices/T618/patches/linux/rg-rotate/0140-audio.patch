+/* inter PA */
+static inline void sprd_codec_pa_d_en(struct snd_soc_component *codec, int on,
+				      int force)
+{
+	int mask;
+	int val;
+
+	sp_asoc_pr_dbg("%s set %d\n", __func__, on);
+	mask = PA_D_EN;
+	val = on ? mask : 0;
+	if (force)
+		snd_soc_component_update_bits(codec, SOC_REG(ANA_CDC14), mask, val);
+	if (on)
+		sprd_codec_psg_state_init(codec);
+	else
+		sprd_codec_psg_state_exit(codec);
+	sprd_codec_intc_enable(on, FGU_LOW_LIMIT_INT_EN |
+			       FGU_HIGH_LIMIT_INT_EN);
+	snd_soc_component_update_bits(codec, SOC_REG(ANA_DCL2), FGU_DIG_EN,
+			    on ? FGU_DIG_EN : 0);
+}
