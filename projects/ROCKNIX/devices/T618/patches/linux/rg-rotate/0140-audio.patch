+static int dacs_switch_event(struct snd_soc_dapm_widget *w,
+			struct snd_kcontrol *kcontrol, int event)
+{
+	int ret = 0;
+	struct snd_soc_component *codec = snd_soc_dapm_to_component(w->dapm);
+
+	sp_asoc_pr_dbg("%s Event is %s\n", __func__,
+		get_event_name(event));
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		snd_soc_component_update_bits(codec, SOC_REG(ANA_CDC17),
+			PA_RSV(0xFFFF), 0);
+		usleep_range(100, 110);
+		break;
+	case SND_SOC_DAPM_POST_PMU:
+		usleep_range(100, 110);
+		snd_soc_component_update_bits(codec, SOC_REG(ANA_CDC19),
+			PA_DPOP_RC_L(0xFFFF), PA_DPOP_RC_L(3));
+		usleep_range(10, 15);
+		snd_soc_component_update_bits(codec, SOC_REG(ANA_CDC17),
+			PA_RSV(0xFFFF), PA_RSV(8));
+		sprd_codec_wait(20);
+		snd_soc_component_update_bits(codec, SOC_REG(ANA_CDC19),
+			PA_DPOP_RC_L(0xFFFF), PA_DPOP_RC_L(0));
+		usleep_range(100, 110);
+		update_switch(codec, SDAPA, 1);
+		usleep_range(100, 110);
+		break;
+	case SND_SOC_DAPM_PRE_PMD:
+		update_switch(codec, SDAPA, 0);
+		usleep_range(10, 15);
+		snd_soc_component_update_bits(codec, SOC_REG(ANA_CDC19),
+			PA_DPOP_RC_L(0xFFFF), PA_DPOP_RC_L(3));
+		sprd_codec_wait(20);
+		snd_soc_component_update_bits(codec, SOC_REG(ANA_CDC17),
+			PA_RSV(0xFFFF), 0);
+		usleep_range(10, 15);
+		snd_soc_component_update_bits(codec, SOC_REG(ANA_CDC19),
+			PA_DPOP_RC_L(0xFFFF), 0);
+		usleep_range(100, 110);
+		break;
+	case SND_SOC_DAPM_POST_PMD:
+		usleep_range(100, 110);
+		break;
+	default:
+		break;
+	}
+	return ret;
+}
