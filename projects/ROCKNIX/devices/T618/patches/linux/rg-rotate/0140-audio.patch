+EXPORT_SYMBOL(ap_apb_gpr_null_check);
+
+void arch_audio_set_ap_apb_gpr(struct regmap *gpr)
+{
+	g_ap_apb_gpr = gpr;
+}
+EXPORT_SYMBOL(arch_audio_set_ap_apb_gpr);
+
+struct regmap *arch_audio_get_ap_apb_gpr(void)
+{
+	return g_ap_apb_gpr;
+}
+EXPORT_SYMBOL(arch_audio_get_ap_apb_gpr);
+
+int anlg_phy_g_null_check(void)
+{
+	if (anlg_phy_g == NULL) {
+		pr_err("ERR: %s anlg_phy_g2 is not initialized!\n",
+			__func__);
+		return -EFAULT;
+	}
+
+	return 0;
+}
+EXPORT_SYMBOL(anlg_phy_g_null_check);
+
+void arch_audio_set_anlg_phy_g(struct regmap *gpr)
+{
+	anlg_phy_g = gpr;
+}
+EXPORT_SYMBOL(arch_audio_set_anlg_phy_g);
+
+struct regmap *arch_audio_get_anlg_phy_g(void)
+{
+	return anlg_phy_g;
+}
+EXPORT_SYMBOL(arch_audio_get_anlg_phy_g);
