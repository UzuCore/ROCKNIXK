+static int adcl_event(struct snd_soc_dapm_widget *w,
+			 struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *codec = snd_soc_dapm_to_component(w->dapm);
+	int ret = 0;
+
+	sp_asoc_pr_dbg("%s  Event is %s\n", __func__,  get_event_name(event));
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		snd_soc_component_update_bits(codec, SOC_REG(ANA_CDC0), ADL_CLK_RST,
+			ADL_CLK_RST);
+		snd_soc_component_update_bits(codec, SOC_REG(ANA_CDC0), ADL_CLK_RST, 0);
+		/*
+		 * ADL_RST should keep be 0-1-0,
+		 * and 1 state should keep 20 cycle of 6.5M clock at least.
+		 */
+		snd_soc_component_update_bits(codec, SOC_REG(ANA_CDC0), ADL_RST, 0);
+		udelay(4);
+		snd_soc_component_update_bits(codec, SOC_REG(ANA_CDC0), ADL_RST, ADL_RST);
+		udelay(4);
+		break;
+	case SND_SOC_DAPM_POST_PMU:
+		snd_soc_component_update_bits(codec, SOC_REG(ANA_CDC0), ADL_RST, 0);
+		/*
+		 * wait 60ms is by experience for the POP,
+		 * the duration of POP is about 70ms.
+		 */
+		sprd_codec_wait(60);
+		break;
+	default:
+		WARN_ON(1);
+		ret = -EINVAL;
+	}
+
+	return ret;
+}
