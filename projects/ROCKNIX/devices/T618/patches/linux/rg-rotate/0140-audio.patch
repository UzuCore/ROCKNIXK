+
+	/* Backend DAIs */
+	SPRD_BE_DAI(VBC_IIS0),
+	SPRD_BE_DAI(VBC_IIS1),
+	SPRD_BE_DAI(VBC_IIS2),
+	SPRD_BE_DAI(VBC_IIS3),
