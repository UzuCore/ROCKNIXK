+#define sprd_priv_to_dev(priv) ((priv)->snd_card.dev)
+#define sprd_priv_to_link(priv, i) ((priv)->snd_card.dai_link + i)
+#define sprd_priv_to_props(priv, i) ((priv)->dai_props + i)
