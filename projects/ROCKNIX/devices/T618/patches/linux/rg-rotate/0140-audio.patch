+	{
+		.name = "VBC_FE_VOICE",
+		.id = VBC_FE_VOICE,
+		.playback = {
+			.stream_name = "VBC_FE_VOICE Playback",
+			.channels_min = 1,
+			.channels_max = 1,
+			.rates = SNDRV_PCM_RATE_8000,
+			.formats = SNDRV_PCM_FMTBIT_S16_LE,
+		},
+		.capture = {
