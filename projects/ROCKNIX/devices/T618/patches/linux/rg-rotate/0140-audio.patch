+static inline int aud_aon_bit_raw_clear(u32 reg, u32 bit)
+{
+	int ret = 0;
+	u32 val = 0;
+
+	aon_apb_gpr_null_check();
+
+	ret = aon_apb_reg_clr(reg, bit);
+
+	pr_debug("bits clear reg(%#x): %#lx\n", reg,
