+		.id = VBC_FE_FAST_PLAYBACK,
+		.playback = {
+			.stream_name = "VBC_FE_FAST_PLAYBACK Playback",
+			.channels_min = 2,
+			.channels_max = 2,
+			.rates = SPRD_PCM_RATES,
+			.formats = SNDRV_PCM_FMTBIT_S16_LE,
