+		break;
+	case BE_DAI_ID_HIFI_P:
+		scene_id = AUDCP_DAI_ID_HIFI;
+		break;
+	case BE_DAI_ID_HIFI_FAST_P:
+		scene_id = AUDCP_DAI_ID_FAST;
+		break;
+	default:
+		scene_id = VBC_DAI_ID_MAX;
+		pr_err("unknown be dai id %d use default dsp id=%d\n",
+		       be_dai_id, scene_id);
+		break;
+	}
+
+	return scene_id;
+}
