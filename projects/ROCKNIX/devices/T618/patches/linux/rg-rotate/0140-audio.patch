+static int ums9230_convert_playback_rate(int rate)
+{
+	switch (rate) {
+	case 8000:
+		return 10;
+	case 9600:
+		return 9;
+	case 11025:
+		return 8;
+	case 12000:
+		return 7;
+	case 16000:
+		return 6;
+	case 22050:
+		return 5;
+	case 24000:
+		return 4;
+	case 32000:
+		return 3;
+	case 44100:
+		return 2;
+	case 48000:
+		return 1;
+	case 96000:
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
