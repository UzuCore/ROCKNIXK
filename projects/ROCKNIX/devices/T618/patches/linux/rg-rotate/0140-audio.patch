+		.name = "VBC_FE_VOICE_CAPTURE",
+		.id = VBC_FE_VOICE_CAPTURE,
+		.capture = {
+			.stream_name = "VBC_FE_VOICE_CAPTURE Capture",
+			.channels_min = 1,
+			.channels_max = 1,
+			.rates = SNDRV_PCM_RATE_8000,
+			.formats = SNDRV_PCM_FMTBIT_S16_LE,
+		},
+		.ops = &sprd_fe_dai_ops,
