+	    g_adc_channel[channel].dma_enabled == 1)
+		return -1;
+
+	mcdt_ad_fifo_clr(channel);
+	mcdt_ad_set_watermark(channel, fullmark, FIFO_LENGTH - 1);
+
+	if (callback != NULL) {
