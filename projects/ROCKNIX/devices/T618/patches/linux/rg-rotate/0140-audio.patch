+static int sprd_codec_get_ctrl(struct snd_soc_component *codec, char *name)
+{
+	struct snd_kcontrol *kctrl;
+	int ret = 0;
+
+	kctrl = sprd_codec_find_ctrl(codec, name);
+	if (kctrl)
+		ret = snd_soc_dapm_kcontrol_get_value(kctrl);
+
+	return ret;
+}
