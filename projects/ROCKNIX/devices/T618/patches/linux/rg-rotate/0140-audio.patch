+static void sprd_codec_pa_boost(struct snd_soc_component *codec, int pa_d_en)
+{
+	int mask;
+	int value;
+	int i = 0, state = 0;
+	struct sprd_codec_priv *sprd_codec = snd_soc_component_get_drvdata(codec);
+
+	mask = PABST_WR_PROT_VALUE(0xFFFF);
+	value = 0x3FA1;
+	snd_soc_component_update_bits(codec, SOC_REG(ANA_WR_PROT0), mask, value);
+	/*
+	 * If classAB, select normal mode;
+	 * then,
+	 * if voltage is low, select normal mode;
+	 * else, select boost mode.
+	 * here we need read battery Q info.
+	 */
+	if (pa_d_en) {
+		mask = DIG_CLK_PABST_EN;
+		snd_soc_component_update_bits(codec, SOC_REG(ANA_DCL1), mask, mask);
+		mask = CLK_PABST_EN | CLK_PABST_32K_EN;
+		snd_soc_component_update_bits(codec, SOC_REG(ANA_CLK0), mask, mask);
+		mask = PA_VCM_BYP_SEL;
+		snd_soc_component_update_bits(codec, SOC_REG(ANA_CDC15), mask, 0);
+		snd_soc_component_update_bits(codec, SOC_REG(ANA_PMU6),
+			PABST_V_INIT(0xffff), 0);
+
+		/* set vcal */
+		mask = PABST_V_CAL(0xffff);
+		value = PABST_V_CAL(sprd_codec->aud_pabst_vcal >> 10);
+		snd_soc_component_update_bits(codec, SOC_REG(ANA_PMU4), mask, value);
+
+		mask = PABST_V(0xffff) | PABST_VADJ_TRIG;
+		 /* defaut is 0x5A->6v, 0x49 ->5.5v */
+		value = PABST_V(0x49) | PABST_VADJ_TRIG;
+		snd_soc_component_update_bits(codec, SOC_REG(ANA_PMU6), mask, value);
+		mask = PABST_EN;
+		if ((sprd_codec->codec_product_info & 0x20) == 0)
+			snd_soc_component_update_bits(codec, SOC_REG(ANA_PMU20), mask, mask);
+		else
+			snd_soc_component_update_bits(codec, SOC_REG(ANA_PMU20), mask, 0);
+
+		/* wait time is about 16ms per ASIC requirement */
+		sprd_codec_wait(10);
+		while (i++ < 10) {
+			state = snd_soc_component_read(codec, SOC_REG(ANA_STS8)) &
+				PABST_SOFT_DVLD;
+			if (state)
+				break;
+			sprd_codec_wait(1);
+		}
+	} else {
+		mask = PA_VCM_BYP_SEL;
+		snd_soc_component_update_bits(codec, SOC_REG(ANA_CDC15), mask, 0);
+		mask = PABST_EN;
+		snd_soc_component_update_bits(codec, SOC_REG(ANA_PMU20), mask, 0);
+		mask = CLK_PABST_EN | CLK_PABST_32K_EN;
+		snd_soc_component_update_bits(codec, SOC_REG(ANA_CLK0), mask, 0);
+		mask = DIG_CLK_PABST_EN;
+		snd_soc_component_update_bits(codec, SOC_REG(ANA_DCL1), mask, 0);
+	}
+}
