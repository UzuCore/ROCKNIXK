+	vbc_codec->iis_tx_lr_mod[VBC_MUX_IIS_TX_DAC2].value = LEFT_HIGH;
+	vbc_codec->iis_rx_lr_mod[VBC_MUX_IIS_RX_ADC0].id = VBC_MUX_IIS_RX_ADC0;
+	vbc_codec->iis_rx_lr_mod[VBC_MUX_IIS_RX_ADC0].value = LEFT_HIGH;
