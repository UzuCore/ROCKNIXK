-	.dapm_widgets = aw87391_rgds_dapm_widgets,
-	.num_dapm_widgets = ARRAY_SIZE(aw87391_rgds_dapm_widgets),
-	.dapm_routes = aw87390_dapm_routes,
-	.num_dapm_routes = ARRAY_SIZE(aw87390_dapm_routes),
