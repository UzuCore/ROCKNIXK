+	 * live gain: the amp keeps VBAT power (no vdd-supply in DT), so this
+	 * probe-time write persists across playback power cycles.
+	 */
+	regmap_write(aw_dev->regmap, AW87391_PAG_REG, AW87391_GAIN_21DB);
