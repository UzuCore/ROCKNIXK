From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Noxwell <beebono@yahoo.com>
Date: Wed, 5 Aug 2026 23:23:08 -0500
Subject: [PATCH 210/225] dts: rg-rotate: mux SDA3/SCL3 to func4 for the DVFS
 I2C channel

Stock hogs both pads at func4, routing them to the TOP-DVFS engine's
autonomous I2C channel to the FAN53555 (DCDC_CPU1); we booted at func1.
Applied via the cpudvfs_dev default pinctrl state at engine probe.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts b/arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts
index d4d81429d..2f3d437c6 100644
--- a/arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts
+++ b/arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts
@@ -352,6 +352,22 @@ sd0_cd: sd0-cd {
         function = "func4";
     };
 
+	/*
+	 * Stock hogs SDA3/SCL3 at func4 (overlay pinctrl): routes the pads to
+	 * the TOP-DVFS engine's autonomous I2C channel to the FAN53555
+	 * (DCDC_CPU1). Ours booted at func1, one suspect for the I2C voltage
+	 * transaction never firing. Applied via cpudvfs_dev probe.
+	 */
+	dvfs_i2c_pin_func: dvfs-i2c-pin-func {
+		pins = "UMS512_SDA3", "UMS512_SCL3";
+		function = "func4";
+	};
+};
+
+&cpudvfs_dev {
+	pinctrl-names = "default";
+	pinctrl-0 = <&dvfs_i2c_pin_func>;
+
 	joypad_pins_func: joypad-pins-func {
 		pins = "UMS512_RFSDA0", "UMS512_RFSCK0", "UMS512_RFSEN0",
 		       "UMS512_RFSEN1", "UMS512_RFCTL6", "UMS512_RFCTL7",
