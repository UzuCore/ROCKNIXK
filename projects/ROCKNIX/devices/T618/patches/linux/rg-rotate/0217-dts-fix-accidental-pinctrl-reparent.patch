From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Noxwell <beebono@yahoo.com>
Date: Thu, 6 Aug 2026 17:24:18 -0500
Subject: [PATCH 217/225] dts: fix accidental pinctrl reparent

---
 arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts b/arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts
index 2f3d437c6..d9d40c27d 100644
--- a/arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts
+++ b/arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts
@@ -362,11 +362,6 @@ dvfs_i2c_pin_func: dvfs-i2c-pin-func {
 		pins = "UMS512_SDA3", "UMS512_SCL3";
 		function = "func4";
 	};
-};
-
-&cpudvfs_dev {
-	pinctrl-names = "default";
-	pinctrl-0 = <&dvfs_i2c_pin_func>;
 
 	joypad_pins_func: joypad-pins-func {
 		pins = "UMS512_RFSDA0", "UMS512_RFSCK0", "UMS512_RFSEN0",
@@ -408,6 +403,11 @@ hall_pin_misc: hall-pin-misc {
 	};
 };
 
+&cpudvfs_dev {
+	pinctrl-names = "default";
+	pinctrl-0 = <&dvfs_i2c_pin_func>;
+};
+
 &iommu_disp {
 	status = "okay";
 };
