@@ -383,6 +417,10 @@ static void sprd_dpu_flip(struct sprd_dpu *dpu)
 		if (!ctx->stopped) {
 			dpu_reg_set(ctx, REG_DPU_CTRL, BIT_DPU_REG_UPDATE);
 			dpu_wait_update_done(dpu);
+		} else {
