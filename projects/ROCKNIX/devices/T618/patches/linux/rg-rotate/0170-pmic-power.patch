+	if (info->temp_min > INT_MIN)
+		bq->temp_min = info->temp_min * 10;
+	if (info->temp_max < INT_MAX)
+		bq->temp_max = info->temp_max * 10;
+
+	power_supply_put_battery_info(bq->charger, info);
+
+	return bq->temp_min > INT_MIN || bq->temp_max < INT_MAX;
