 					map1 {
 						trip = <&cputop0_alert0>;
-						cooling-device = <&cpu_idle_cooling THERMAL_NO_LIMIT 50>;
+						cooling-device = <&cpu_idle_cooling THERMAL_NO_LIMIT 80>;
