From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Noxwell <beebono@yahoo.com>
Date: Mon, 3 Aug 2026 14:03:21 -0500
Subject: [PATCH 199/225] arm64: dts: ums512: select POWERCAP, cap idle
 injection at 50%

CONFIG_IDLE_INJECT sits inside "if POWERCAP" in drivers/powercap/Kconfig,
and POWERCAP was never set, so Kconfig silently dropped both IDLE_INJECT and
CPU_IDLE_THERMAL (which depends on it) and no idle cooling device appeared.
Select POWERCAP so they survive; verify with

  make ums512_defconfig && grep CPU_IDLE_THERMAL .config

since a defconfig entry whose dependencies are unmet is discarded without any
diagnostic.

With the device finally registering, step_wise drove it to the top state and
wedged the machine for ~15s at a time. cpuidle cooling states are a
percentage of injected idle and cpuidle_cooling_runtime() computes

  run_us = idle_us * 100 / state - idle_us

so state 100 yields zero run time - the cpus never execute, and ssh and input
stop with them. The maps passed THERMAL_NO_LIMIT as the upper bound, letting
it get there. Cap them at 50 (50% duty) instead.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/sprd/ums512.dtsi | 32 +++++++++++++++++++---------
 arch/arm64/configs/ums512_defconfig  |  1 +
 2 files changed, 23 insertions(+), 10 deletions(-)

diff --git a/arch/arm64/boot/dts/sprd/ums512.dtsi b/arch/arm64/boot/dts/sprd/ums512.dtsi
index 71685da74..6b2277ade 100644
--- a/arch/arm64/boot/dts/sprd/ums512.dtsi
+++ b/arch/arm64/boot/dts/sprd/ums512.dtsi
@@ -203,6 +203,18 @@ CPU0: cpu@0 {
 			 * it serves - a node per cpu would just create
 			 * duplicate devices contending with each other.
 			 */
+			/*
+			 * State is a percentage of injected idle, and
+			 * cpuidle_cooling_runtime() gives a run time of
+			 * idle_us * 100 / state - idle_us, so state 100 means
+			 * *zero* run time and the machine stops dead. The
+			 * cooling maps below therefore cap the upper state
+			 * rather than passing THERMAL_NO_LIMIT.
+			 *
+			 * duration-us matches CORE_PD's min-residency-us so an
+			 * injected idle period is long enough to actually
+			 * enter the deep state rather than just wfi.
+			 */
 			cpu_idle_cooling: thermal-idle {
 				#cooling-cells = <2>;
 				duration-us = <10000>;
@@ -2281,7 +2293,7 @@ map0 {
 
 					map1 {
 						trip = <&cputop0_alert0>;
-						cooling-device = <&cpu_idle_cooling THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+						cooling-device = <&cpu_idle_cooling THERMAL_NO_LIMIT 50>;
 					};
 				};
 			};
@@ -2314,7 +2326,7 @@ map0 {
 
 					map1 {
 						trip = <&cpu0_alert0>;
-						cooling-device = <&cpu_idle_cooling THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+						cooling-device = <&cpu_idle_cooling THERMAL_NO_LIMIT 50>;
 					};
 				};
 			};
@@ -2347,7 +2359,7 @@ map0 {
 
 					map1 {
 						trip = <&cpu1_alert0>;
-						cooling-device = <&cpu_idle_cooling THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+						cooling-device = <&cpu_idle_cooling THERMAL_NO_LIMIT 50>;
 					};
 				};
 			};
@@ -2380,7 +2392,7 @@ map0 {
 
 					map1 {
 						trip = <&cpu2_alert0>;
-						cooling-device = <&cpu_idle_cooling THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+						cooling-device = <&cpu_idle_cooling THERMAL_NO_LIMIT 50>;
 					};
 				};
 			};
@@ -2413,7 +2425,7 @@ map0 {
 
 					map1 {
 						trip = <&cpu7_alert0>;
-						cooling-device = <&cpu_idle_cooling THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+						cooling-device = <&cpu_idle_cooling THERMAL_NO_LIMIT 50>;
 					};
 				};
 			};
@@ -2447,7 +2459,7 @@ map0 {
 
 					map1 {
 						trip = <&cputop1_alert0>;
-						cooling-device = <&cpu_idle_cooling THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+						cooling-device = <&cpu_idle_cooling THERMAL_NO_LIMIT 50>;
 					};
 				};
 			};
@@ -2518,7 +2530,7 @@ map0 {
 
 					map1 {
 						trip = <&cpu3_alert0>;
-						cooling-device = <&cpu_idle_cooling THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+						cooling-device = <&cpu_idle_cooling THERMAL_NO_LIMIT 50>;
 					};
 				};
 			};
@@ -2551,7 +2563,7 @@ map0 {
 
 					map1 {
 						trip = <&cpu4_alert0>;
-						cooling-device = <&cpu_idle_cooling THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+						cooling-device = <&cpu_idle_cooling THERMAL_NO_LIMIT 50>;
 					};
 				};
 			};
@@ -2584,7 +2596,7 @@ map0 {
 
 					map1 {
 						trip = <&cpu5_alert0>;
-						cooling-device = <&cpu_idle_cooling THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+						cooling-device = <&cpu_idle_cooling THERMAL_NO_LIMIT 50>;
 					};
 				};
 			};
@@ -2617,7 +2629,7 @@ map0 {
 
 					map1 {
 						trip = <&cpu6_alert0>;
-						cooling-device = <&cpu_idle_cooling THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+						cooling-device = <&cpu_idle_cooling THERMAL_NO_LIMIT 50>;
 					};
 				};
 			};
diff --git a/arch/arm64/configs/ums512_defconfig b/arch/arm64/configs/ums512_defconfig
index 79e3c4f78..2c7731b82 100644
--- a/arch/arm64/configs/ums512_defconfig
+++ b/arch/arm64/configs/ums512_defconfig
@@ -464,6 +464,7 @@ CONFIG_SENSORS_LM90=m
 CONFIG_SENSORS_PWM_FAN=m
 CONFIG_SENSORS_INA2XX=m
 CONFIG_SENSORS_INA3221=m
+CONFIG_POWERCAP=y
 CONFIG_IDLE_INJECT=y
 CONFIG_THERMAL=y
 CONFIG_THERMAL_DEFAULT_GOV_STEP_WISE=y
