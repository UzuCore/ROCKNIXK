diff --git a/arch/arm64/boot/dts/sprd/sprd-sound-fe-be.dtsi b/arch/arm64/boot/dts/sprd/sprd-sound-fe-be.dtsi
index 19aa3a998..fb679f7ca 100644
--- a/arch/arm64/boot/dts/sprd/sprd-sound-fe-be.dtsi
+++ b/arch/arm64/boot/dts/sprd/sprd-sound-fe-be.dtsi
@@ -1121,8 +1121,38 @@ codec {
 	};
 
 	/*
-	 * The vendor "all-i2s" test card (sprd-pcm-iis + i2s0 +
-	 * unisoc,i2s-null-codec) is omitted: the i2s DAI and 2-stage DMA
-	 * platform drivers are not ported.
+	 * AP-side i2s0 playback/capture path. Unlike the VBC card above
+	 * (which rides the audcp agcp_dma whose completion IRQ never
+	 * reaches the AP), this uses the AP-owned ap_dma, so DMA period
+	 * interrupts are expected to work natively. Disabled by default;
+	 * the board dts enables ap_dma, i2s0 and this card.
 	 */
+	sprd_pcm_iis: sprd-pcm-iis {
+		compatible = "unisoc,sharkl5-pcm-platform";
+		#sound-dai-cells = <0>;
+		dmas = <&ap_dma 5 &ap_dma 6>;
+		dma-names = "iis0_tx", "iis0_rx";
+		sprd,dma-2stage-usecase = <2>;
+		sprd,node-count-2stage-level-1 = <1>;
+		sprd,syscon-pmu-apb = <&pmu_apb_regs>;
+		sprd,dma-2stage-level-1-int-source = <1>;
+	};
+
+	sound_sprd_ap_alliis: sound@1 {
+		compatible = "unisoc,i2s-null-codec";
+		status = "disabled";
+		sprd-audio-card,name = "all-i2s";
+		/* dai-links */
+		sprd-audio-card,dai-link@0 {
+			plat {
+				sound-dai = <&sprd_pcm_iis>;
+			};
+			cpu {
+				sound-dai = <&i2s0>;
+			};
+			codec {
+				sound-dai = <0 0>;
+			};
+		};
+	};
 };
diff --git a/arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts b/arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts
index 50336cc5d..d01d444ab 100644
--- a/arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts
+++ b/arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts
@@ -493,3 +493,40 @@ speaker_amp: audio-codec@58 {
 		sound-name-prefix = "Speaker Amp";
 	};
 };
+
+/*
+ * AP-side i2s0 audio path (all-i2s test card). Brought up to extend the
+ * vendor audio port beyond the working VBC/agcp card. Rides ap_dma (its
+ * own AP-owned DMA + GIC_SPI 24), so it should get native DMA period
+ * interrupts rather than the hrtimer workaround the VBC path needs.
+ *
+ * i2s0 is configured for the stock PCM/BT-SCO mode (bus_type=1, 8 kHz,
+ * short frame). Adjust sprd,config_type/bus_type for raw i2s use.
+ */
+&ap_dma {
+	status = "okay";
+};
+
+&i2s0 {
+	sprd,config_type = "pcm";
+	sprd,slave_timeout = <0xF11>;
+	sprd,fs = <8000>;
+	sprd,bus_type = <1>;
+	sprd,rtx_mode = <3>;
+	sprd,byte_per_chan = <1>;
+	sprd,slave_mode = <0>;
+	sprd,lsb = <0>;
+	sprd,lrck = <0>;
+	sprd,low_for_left = <1>;
+	sprd,clk_inv = <0>;
+	sprd,pcm_short_frame = <1>;
+	sprd,pcm_slot = <0x1>;
+	sprd,pcm_cycle = <1>;
+	sprd,tx_watermark = <12>;
+	sprd,rx_watermark = <20>;
+	status = "okay";
+};
+
+&sound_sprd_ap_alliis {
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/sprd/ums512.dtsi b/arch/arm64/boot/dts/sprd/ums512.dtsi
index 8b2c8b85b..39c6b182d 100644
--- a/arch/arm64/boot/dts/sprd/ums512.dtsi
+++ b/arch/arm64/boot/dts/sprd/ums512.dtsi
@@ -1297,6 +1297,37 @@ ap_clk: clock-controller@20200000 {
 			#clock-cells = <1>;
 		};
 
+		ap_dma: dma-controller@20000000 {
+			/* AP-owned DMA (GIC_SPI 24) used by the i2s0 audio path;
+			 * distinct from the audcp agcp_dma whose IRQ is dead.
+			 */
+			compatible = "sprd,sharkl5pro-dma", "sprd,sc9860-dma";
+			reg = <0 0x20000000 0 0x4000>;
+			interrupts = <GIC_SPI 24 IRQ_TYPE_LEVEL_HIGH>;
+			#dma-cells = <1>;
+			#dma-channels = <28>;
+			clock-names = "enable";
+			clocks = <&apahb_gate CLK_DMA_PUB_EB>;
+			status = "disabled";
+		};
+
+		i2s0: i2s@70c00000 {
+			/* binds the ported unisoc audio_driver i2s CPU-DAI */
+			compatible = "unisoc,i2s";
+			reg = <0 0x70c00000 0 0x1000>;
+			sprd,dai_name = "i2s_bt_sco0";
+			sprd,hw_port = <0>;
+			sprd,syscon-ap-apb = <&ap_apb_regs>;
+			#sound-dai-cells = <0>;
+			clock-names = "clk_iis0",
+				      "clk_twpll_128m",
+				      "clk_twpll_153m6";
+			clocks = <&ap_clk CLK_AP_IIS0>,
+				 <&pll2 CLK_TWPLL_128M>,
+				 <&pll2 CLK_TWPLL_153M6>;
+			status = "disabled";
+		};
+
 		aon_clk: clock-controller@32080000 {
 			compatible = "sprd,ums512-aonapb-clk";
 			reg = <0 0x32080000 0 0x1000>;
diff --git a/sound/soc/sprd/vendor/Makefile b/sound/soc/sprd/vendor/Makefile
index 99c4b6a3f..51b9b4757 100644
--- a/sound/soc/sprd/vendor/Makefile
+++ b/sound/soc/sprd/vendor/Makefile
@@ -4,6 +4,12 @@
 # (sharkl5pro boards build the SC2730 codec flavour).
 ccflags-y += -DCONFIG_SND_SOC_UNISOC_CODEC_SC2730
 
+# Enable the AP-side i2s CPU-DAI + its "all-i2s" test card. This also flips
+# sprd-i2s.h over to exporting the real i2s_config/proc symbols that
+# sprd-dmaengine-pcm.c already references for the i2s DMA use-cases (they
+# resolve to inline stubs otherwise).
+ccflags-y += -DCONFIG_SND_SOC_UNISOC_I2S
+
 # Link order matters: these are all built-in platform drivers registered
 # at device_initcall time, and probes fire in registration order. The
 # shared-memory manager and agdsp-access must be live before audio-sipc,
@@ -28,6 +34,8 @@ snd-soc-unisoc-vbc-v4-sc2730-y := \
 	sprd-asoc-card-utils.o \
 	sprd-asoc-card-utils-hook.o \
 	sprd-asoc-card-utils-legacy.o \
-	vbc-rxpx-codec-sc27xx.o
+	vbc-rxpx-codec-sc27xx.o \
+	sprd-i2s.o \
+	sprd-i2s-null-codec.o
 
 obj-$(CONFIG_SND_SOC_UNISOC_VBC_V4_SC2730) += snd-soc-unisoc-vbc-v4-sc2730.o
