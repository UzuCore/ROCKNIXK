diff --git a/sound/soc/sprd/vendor/sprd-i2s-null-codec.c b/sound/soc/sprd/vendor/sprd-i2s-null-codec.c
new file mode 100755
index 000000000..4f4025a8b
--- /dev/null
+++ b/sound/soc/sprd/vendor/sprd-i2s-null-codec.c
@@ -0,0 +1,159 @@
+/*
+ * sound/soc/sprd/i2s-null-codec.c
+ *
+ * Copyright (C) 2015 SpreadTrum Ltd.
+ *
