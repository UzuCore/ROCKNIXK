+static void set_fm_supe_freq(enum wcn_sub_sys subsys,
+			     int val, unsigned long sub_state)
+{
+	switch (subsys) {
+	case MARLIN_FM:
+		if (test_bit(MARLIN_GNSS, &sub_state) && (val == 1))
+			enable_spur_remove();
+		else
+			disable_spur_remove();
+		break;
+	case MARLIN_GNSS:
+		if (test_bit(MARLIN_FM, &sub_state) && (val == 1))
+			enable_spur_remove();
+		else
+			disable_spur_remove();
+		break;
+	default:
+		break;
+	}
+}
