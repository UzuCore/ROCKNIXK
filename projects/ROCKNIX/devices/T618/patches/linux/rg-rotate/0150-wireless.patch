+	ret = kstrtoul(sysfs_info.loglevel_buf + 11, 10, &tmp);
+	if (ret < 0) {
+		WCN_ERR("incorrect get loglevel\n");
+		return -EINVAL;
+	}
+
+	WCN_DBG("show:len=%zd, buf=%s, level=%d\n", sysfs_info.loglevel_len,
+		sysfs_info.loglevel_buf, sysfs_info.loglevel);
+
+	return 0;
+}
