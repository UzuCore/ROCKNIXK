diff --git a/drivers/net/wireless/sprdwcn/platform/wcn_debugfs.c b/drivers/net/wireless/sprdwcn/platform/wcn_debugfs.c
new file mode 100644
index 0000000000000000000000000000000000000000..07384246f059332e5cfe9f2d08eacfe2e60cb46f
--- /dev/null
+++ b/drivers/net/wireless/sprdwcn/platform/wcn_debugfs.c
@@ -0,0 +1,168 @@
+/*
