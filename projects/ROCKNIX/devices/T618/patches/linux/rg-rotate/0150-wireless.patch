+	s8 ht40_power_offset;
+	s8 vht40_power_offset;
+	s8 vht80_power_offset;
+	s8 sar_power_offset;
+	s8 mean_power_offset;
+	s8 reserved[2];
+};
+
+/* [Section 8: Reg Domain] */
