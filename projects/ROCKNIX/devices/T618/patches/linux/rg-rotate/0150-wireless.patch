+void __sdiohal_debug_point_store(int channel, int num, struct mbuf_t *head,
+	struct mbuf_t *tail, struct sdiohal_xmit_debug_point *point, bool tx_direct)
+{
+	point->channel = channel;
+	point->head = head;
