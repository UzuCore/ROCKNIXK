+		.chn_config.sipc_ch = WCN_INIT_SIPC_SBUF(
+				WCN_SIPC_DST, SIPC_CHN_LOOPCHECK,
+				WCN_CHN_CREATE | WCN_CHN_CALLBACK,
+				"sbuf_loopcheck", 0, 128, 1,
+				0x400, 0x400),
+	},
+	{
+		.channel = WCN_SIPC_AT_RX,
