+/* wifipa bound XTLEN3, gnss not need wifipa bound */
+static inline int wcn_wifipa_bound_xtl(bool enable)
+{
+	return wcn_pmic_do_bound(&marlin_dev->avdd33_bound_wbreq, enable);
+}
