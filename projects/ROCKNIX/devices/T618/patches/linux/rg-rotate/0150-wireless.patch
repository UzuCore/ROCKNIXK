+int sdiohal_dt_read(unsigned int system_addr, void *buf,
+			   unsigned int len)
+{
+	struct sdiohal_data_t *p_data = sdiohal_get_data();
+	unsigned int remainder = len;
+	unsigned int trans_len;
+	int ret;
+
+	if (sdiohal_card_lock(p_data))
+		return -ENODEV;
