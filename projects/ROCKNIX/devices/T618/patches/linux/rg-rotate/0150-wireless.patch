+			       "start_dump_bt_bb_rx_buf_reg",
+			       BT_BB_RX_BUF_SIZE,
+			       strlen("start_dump_bt_bb_rx_buf_reg"));
+	WCN_INFO("mdbg dump bt_bb_rx_buf %ld ok!\n", count);
