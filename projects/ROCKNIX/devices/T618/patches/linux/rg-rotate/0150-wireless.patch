+static void sdiohal_disable_rx_irq(int irq)
+{
+	struct sdiohal_data_t *p_data = sdiohal_get_data();
+
+	sdiohal_atomic_add(1, &p_data->irq_cnt);
+	disable_irq_nosync(irq);
+}
