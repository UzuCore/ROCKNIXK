diff --git a/drivers/net/wireless/sprdwcn/platform/mem_pd_mgr.c b/drivers/net/wireless/sprdwcn/platform/mem_pd_mgr.c
new file mode 100644
index 0000000000000000000000000000000000000000..5a4fc4e0358e46898d445ff27281b566db3681df
--- /dev/null
+++ b/drivers/net/wireless/sprdwcn/platform/mem_pd_mgr.c
@@ -0,0 +1,764 @@
+/*
+ * Copyright (C) 2013 Spreadtrum Communications Inc.
+ *
+ * Filename : slp_mgr.c
+ * Abstract : This file is a implementation for  sleep manager
+ *
