+	},
+};
+
+struct mchn_ops_t mdbg_proc_ops_sipc[MDBG_ASSERT_RX_OPS + 1] = {
+	{
+		.channel = WCN_SIPC_AT_TX,
+		.inout = WCNBUS_TX,
+		.pool_size = 5,
+		.pop_link = mdbg_tx_cb,
+		.chn_config.sipc_ch = WCN_INIT_SIPC_SBUF(
+				WCN_SIPC_DST, SIPC_CHN_ATCMD, 0,
+				"sbuf_atcmd_tx", 5, 128, 0,
+				0x2400, 0x2400)
+	},
