+	/* 0x17cf68 */
+	u32 sleep_flag_addr;
+	/* 0x17cf6c */
+	u32 efuse_temper_magic;
+	/* 0x17cf70 */
+	u32 efuse_temper_val;
+	/* 0x17cf74 */
