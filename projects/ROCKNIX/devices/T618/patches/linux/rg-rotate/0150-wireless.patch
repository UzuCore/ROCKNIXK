+static void mdbg_dump_str(char *str, int str_len)
+{
+	if (!str)
+		return;
+
+	mdbg_ring_write(mdbg_dev->ring_dev->ring, str, str_len);
+	wake_up_log_wait();
+	WCN_INFO("dump str finish!");
+}
