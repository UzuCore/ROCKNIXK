new file mode 100644
index 0000000000000000000000000000000000000000..602bbfb83f73019e8e331bea3d30adcb20c6d59e
--- /dev/null
+++ b/drivers/net/wireless/sprdwcn/Kconfig
@@ -0,0 +1,36 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# Unisoc Marlin3-Lite (SC2355) external WCN combo (Wi-Fi/BT/FM/GNSS) over SDIO.
+#
+menu "Unisoc WCN (Marlin3) device drivers"
+
+config UNISOC_WCN_BSP
+	tristate "Unisoc external WCN (Marlin3/SC2355) platform support"
+	depends on MMC && OF
+	help
+	  Platform/transport core for the Unisoc external WCN combo chip
+	  (Marlin3-Lite / SC2355) attached over SDIO: chip power sequencing,
+	  firmware download, sdiohal transport and channel mux. Wi-Fi, BT,
+	  FM and GNSS function drivers sit on top of this. Say M/Y to enable.
+
+config SC23XX
+	bool "SC23XX-family chip support"
+	depends on UNISOC_WCN_BSP
+	default UNISOC_WCN_BSP
+
+config SC2355
+	bool "SC2355 (Marlin3-Lite) chip support"
+	depends on SC23XX
+	default SC23XX
+
+config SDIOHAL
+	bool "SDIO HAL transport"
+	depends on SC23XX
+	default SC23XX
+
+config WCN_SLP
+	bool "WCN sleep/power management"
+	depends on SDIOHAL
+	default SDIOHAL
+
+endmenu
diff --git a/drivers/net/wireless/sprdwcn/Makefile b/drivers/net/wireless/sprdwcn/Makefile
new file mode 100755
index 0000000000000000000000000000000000000000..d0f230e790fb667603a0b2f551ca69ca507a7a71
--- /dev/null
+++ b/drivers/net/wireless/sprdwcn/Makefile
@@ -0,0 +1,51 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# Unisoc Marlin3-Lite (SC2355) external WCN combo over SDIO.
+# Trimmed from the 5.4 vendor BSP to the external-SDIO path only:
+# integrated-chip boot (wcn_integrate*), SIPC and PCIe transports removed.
+#
+subdir-ccflags-y := \
+	-I $(srctree)/$(src)/include \
+	-I $(srctree)/$(src)/boot \
+	-I $(srctree)/$(src)/platform \
+	-I $(srctree)/$(src)/platform/rf \
+	-I $(srctree)/$(src)/platform/gnss \
+	-I $(srctree)/$(src)/sleep
+
+obj-$(CONFIG_UNISOC_WCN_BSP) += wcn_bsp.o
+
+# core bus + unified platform-driver entry
+wcn_bsp-y += wcn_bus.o
+wcn_bsp-y += sprd_wcn.o
+
+# platform (external marlin3 boot + glue)
+wcn_bsp-y += platform/wcn_parn_parser.o
+wcn_bsp-y += platform/wcn_txrx.o
+wcn_bsp-y += platform/wcn_log.o
+wcn_bsp-y += platform/wcn_misc.o
+wcn_bsp-y += platform/bufring.o
+wcn_bsp-y += platform/wcn_op.o
+wcn_bsp-y += platform/sysfs.o
+wcn_bsp-y += platform/reset.o
+wcn_bsp-y += platform/loopcheck.o
+wcn_bsp-y += platform/wcn_boot.o
+wcn_bsp-y += platform/mem_pd_mgr.o
+wcn_bsp-y += platform/wcn_pm_qos.o
+wcn_bsp-y += platform/wcn_procfs.o
+# Tier-2 dropped for the boot milestone (see wcn_stubs.c for the few symbols the
+# core still references): wcn_debugfs (0 core calls), wcn_dump (0 core calls,
+# set_fs file I/O), wcn_chr (debug char dev), wcn_ca_trusty (Trusty TEE, absent
+# from mainline), gnss/gnss_dump/wcn_gnss_dump (GNSS, deferred past boot).
+wcn_bsp-y += platform/wcn_stubs.o
+
+# sleep / power
+wcn_bsp-y += sleep/sdio_int.o
+wcn_bsp-y += sleep/slp_mgr.o
+wcn_bsp-y += sleep/slp_sdio.o
+
+# sdio transport (sdiohal)
+wcn_bsp-y += sdio/sdiohal_main.o
