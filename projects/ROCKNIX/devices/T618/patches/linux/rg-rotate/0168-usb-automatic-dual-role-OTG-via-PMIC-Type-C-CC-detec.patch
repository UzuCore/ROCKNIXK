From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Noxwell <beebono@yahoo.com>
Date: Mon, 13 Jul 2026 20:25:53 -0500
Subject: [PATCH 168/225] usb: automatic dual-role OTG via PMIC Type-C CC
 detection

Replace the userspace forced-peripheral hack with real CC-based dual-role
operation driven by the sc2730 PMIC Type-C port manager (sc27xx_pd), so
the port selects host or device automatically on cable attach.

VBUS in host mode is sourced by the AW32257 (bq2415x) charger's OTG boost;
there is no discrete 5V regulator on this board. Expose that boost as a
"usb-otg-vbus" regulator so the TCPM can source 5V on host attach.

  bq2415x: add a USB OTG VBUS regulator provider whose enable/disable map
    to charger BOOST/OFF mode; build the charger in (m -> y) so the
    provider is present before the built-in TCPM resolves vbus-supply.

  musb/sprd: pick up an optional "vbus" supply and drive it from the role
    switch state machine for boards with no TCPM (dormant here, since VBUS
    now lives on the PD node and is owned by the TCPM exclusively).

  sc27xx_pd: three fixes to get the TCPM to register and source VBUS:
    - vconn: get_optional instead of get_exclusive, so an absent supply
      (no VCONN switch on this board) yields NULL rather than a dummy that
      -EINVALs the exclusive request and fails probe.
    - as source, report vbus_present from the commanded state: the PMIC
      VBUS_OK comparator never senses the external charger boost, so
      polling it timed out (-110) and stalled the SRC state machine.
    - fix a copy-paste is_enabled(vbus) -> vconn in the vconn path.

  dts: enable &pmic_typec_pd with a usb-c-connector graphed to &usb's role
    switch, move vbus-supply onto the PD node, add the bq2415x usb-otg-vbus
    regulator subnode, and mark the connector pd-disable (CC role detection
    only, no PD contracts, which avoids the source/sink-pdo requirement).
    Drop the now-inert extcon-usb-gpio node and its &usb/&hsphy/charger
    references: nothing consumed it (the PHY force-asserts VBUS-valid in
    hardware) and removal was confirmed to have no effect.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts | 48 +++++++++++-
 arch/arm64/configs/ums512_defconfig           |  2 +-
 drivers/power/supply/bq2415x_charger.c        | 78 +++++++++++++++++++
 drivers/usb/musb/sprd.c                       | 28 +++++++
 drivers/usb/typec/tcpm/sc27xx_pd.c            | 27 ++++++-
 5 files changed, 178 insertions(+), 5 deletions(-)

diff --git a/arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts b/arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts
index ac8407259..c2b852068 100644
--- a/arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts
+++ b/arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts
@@ -685,6 +685,48 @@ &hsphy {
 &usb {
 	status = "okay";
 	dr_mode = "otg";
+	usb-role-switch;
+	role-switch-default-mode = "peripheral";
+
+	/*
+	 * OF-graph link to the PMIC Type-C port manager (sc27xx_pd). CC-based
+	 * attach/detach drives this role switch; VBUS is owned by the TCPM
+	 * (vbus-supply lives on &pmic_typec_pd, not here) so its exclusive
+	 * regulator request doesn't collide with the musb glue.
+	 */
+	port {
+		usb_hs_ep: endpoint {
+			remote-endpoint = <&tcpc_hs_ep>;
+		};
+	};
+};
+
+&pmic_typec_pd {
+	status = "okay";
+	/* charger OTG boost, sourced on host attach by the TCPM */
+	vbus-supply = <&usb_otg_vbus>;
+
+	connector {
+		compatible = "usb-c-connector";
+		label = "USB-C";
+		power-role = "dual";
+		data-role = "dual";
+		try-power-role = "sink";
+		/*
+		 * CC-based OTG role detection only, no USB-PD. Skips the
+		 * source/sink-pdo requirement that -EINVALs tcpm_register_port
+		 * for a PD-capable port; DRP toggling, VBUS sourcing and the
+		 * role switch all still work.
+		 */
+		pd-disable;
+		typec-power-opmode = "default";
+
+		port {
+			tcpc_hs_ep: endpoint {
+				remote-endpoint = <&usb_hs_ep>;
+			};
+		};
+	};
 };
 
 &gpu {
@@ -759,7 +801,7 @@ &i2c4 {
 	#address-cells = <1>;
 	#size-cells = <0>;
 
-	sc2730_charger: charger@6a {
+	charger: charger@6a {
 		compatible = "ti,bq24158";
 		reg = <0x6a>;
 		ti,current-limit = <1800>;
@@ -768,6 +810,10 @@ sc2730_charger: charger@6a {
 		ti,charge-current = <2000>;
 		ti,termination-current = <200>;
 		ti,resistor-sense = <33>;
+
+		usb_otg_vbus: usb-otg-vbus {
+			regulator-name = "usb-otg-vbus";
+		};
 	};
 };
 
