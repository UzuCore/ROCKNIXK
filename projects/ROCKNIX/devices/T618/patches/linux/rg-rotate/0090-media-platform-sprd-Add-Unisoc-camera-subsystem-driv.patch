+
+struct sprd_dcam {
+	struct v4l2_subdev subdev;
+	struct media_pad pads[SPRD_DCAM_PAD_NUM];
+	struct sprd_config_vdev config;
+	struct sprd_lsc_vdev lsc;
+	struct sprd_capture_vdev capture;
