Subject: [PATCH] sprd: usb-phy support for UMS512

Consolidated from beebono/linux-mainline-sprd rg-rotate 464b3e7bf45bb300e190339977abba36c8078e1f, rebased onto Linux 7.1.2.
Original authors and patch hashes are recorded in series-origin.json.

diff --git a/drivers/phy/Kconfig b/drivers/phy/Kconfig
index 227b9a4c612e8c7a2ba7374e5ffcd9d9cb22810a..758d5f3bd6faaf21beae1df73248ca886893b8bc 100644
--- a/drivers/phy/Kconfig
+++ b/drivers/phy/Kconfig
@@ -126,6 +126,15 @@ config PHY_SNPS_EUSB2
 	  Enable support for the USB high-speed SNPS eUSB2 phy on select
 	  SoCs. The PHY is usually paired with a Synopsys DWC3 USB controller.
 
+config PHY_SPRD_USB2
+	tristate "Unisoc USB2 PHY driver"
+	depends on ARCH_SPRD || COMPILE_TEST
+	depends on OF
+	select GENERIC_PHY
+	help
+	  Enable support for the USB2.0 PHY found on Unisoc SoCs such as
+	  UMS9230.
+
