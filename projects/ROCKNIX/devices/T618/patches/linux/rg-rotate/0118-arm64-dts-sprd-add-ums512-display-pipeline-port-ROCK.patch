+				reg = <0x20300000 0x800>;
+				interrupts = <GIC_SPI 27 IRQ_TYPE_LEVEL_HIGH>;
+				clocks = <&apahb_gate CLK_DISPC_EB>,
+					 <&ap_clk CLK_DISPC0>,
+					 <&ap_clk CLK_DISPC0_DPI>;
+				clock-names = "core", "clk", "dpi";
+				iommus = <&iommu_disp>;
+				status = "disabled";
+
+				dpu_port: port {
+					dpu_out: endpoint {
+						remote-endpoint = <&dsi_in>;
+					};
+				};
+			};
+
+			iommu_disp: iommu@20300800 {
+				compatible = "sprd,ums512-iommu", "sprd,iommu-v1";
+				reg = <0x20300800 0x80>;
+				sprd,iova-range = <0x90000000 0x10000000>;
+				#iommu-cells = <0>;
+				status = "disabled";
+			};
+
+			dsi: dsi@20400000 {
+				compatible = "sprd,ums512-dsi-host", "sprd,ums9230-dsi-host";
+				reg = <0x20400000 0x1000>;
+				interrupts = <GIC_SPI 30 IRQ_TYPE_LEVEL_HIGH>,
+					     <GIC_SPI 31 IRQ_TYPE_LEVEL_HIGH>;
+				clocks = <&apahb_gate CLK_DSI_EB>;
+				clock-names = "pclk";
+
+				/*
+				 * MIPI DPHY analog block glue. Mirrors stock dphy
+				 * node enable-syscon / power-syscon: driver sets
+				 * phy-en bits to enable and clears phy-pwr bit to
+				 * power up the analog driver.
+				 */
+				sprd,phy-en-syscon = <&ap_ahb_regs 0x40 0x03>;
+				sprd,phy-pwr-syscon = <&ap_apb_regs 0x35c 0x08>;
+				status = "disabled";
+
+				ports {
+					#address-cells = <1>;
+					#size-cells = <0>;
+
+					port@0 {
+						reg = <0>;
+						dsi_in: endpoint {
+							remote-endpoint = <&dpu_out>;
+						};
+					};
+
+					port@1 {
+						reg = <1>;
+						dsi_out: endpoint { };
+					};
+				};
+			};
+		};
 	};
 
