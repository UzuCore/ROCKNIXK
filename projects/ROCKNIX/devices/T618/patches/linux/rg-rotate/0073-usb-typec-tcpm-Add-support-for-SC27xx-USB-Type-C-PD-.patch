+static int sc27xx_pd_set_roles(struct tcpc_dev *tcpc, bool attached,
+			       enum typec_role role, enum typec_data_role data)
+{
+	struct sc27xx_pd *pd = tcpc_to_sc27xx_pd(tcpc);
+	int ret;
+
+	mutex_lock(&pd->lock);
+	ret = regmap_assign_bits(pd->regmap,
+				 pd->base + SC27XX_PD_CFG0,
+				 SC27XX_PD_SRC_SINK_MODE,
+				 role != TYPEC_SINK);
+	mutex_unlock(&pd->lock);
+
+	return ret;
+}
+
+static int sc27xx_pd_set_vconn(struct tcpc_dev *tcpc, bool on)
+{
+	struct sc27xx_pd *pd = tcpc_to_sc27xx_pd(tcpc);
+	int ret = 0;
+
+	mutex_lock(&pd->lock);
+
+	if (!pd->vconn || pd->vconn_on == on)
+		goto out;
+
+	pd->vconn_on = on;
+
+	if (on)
+		ret = regulator_enable(pd->vconn);
+	else
+		ret = regulator_disable(pd->vconn);
+
+out:
