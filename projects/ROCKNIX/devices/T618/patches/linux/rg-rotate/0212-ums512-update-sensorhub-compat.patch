From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Noxwell <beebono@yahoo.com>
Date: Thu, 30 Jul 2026 22:52:22 -0500
Subject: [PATCH 212/225] ums512: update sensorhub compat

---
 arch/arm64/boot/dts/sprd/ums512.dtsi | 81 ++++++++++++++++++++++++++++
 arch/arm64/configs/ums512_defconfig  |  7 +++
 drivers/remoteproc/sprd_pmsys.c      | 12 +++++
 3 files changed, 100 insertions(+)

diff --git a/arch/arm64/boot/dts/sprd/ums512.dtsi b/arch/arm64/boot/dts/sprd/ums512.dtsi
index c3e2f0108..d92c6bb41 100644
--- a/arch/arm64/boot/dts/sprd/ums512.dtsi
+++ b/arch/arm64/boot/dts/sprd/ums512.dtsi
@@ -38,6 +38,25 @@ audio_reserved: audio-mem@87400000 {
 			no-map;
 		};
 
+		/*
+		 * DDR belonging to the pm_sys CM4 sensor hub. Stock reserves
+		 * this as one 3MB block (sp_ddr-mem@88000000) because its 5.4
+		 * driver takes the split from the sipc-pmsys smem-info triples
+		 * instead. sprd_pmsys.c wants the two halves as separate
+		 * regions, so split it here - the totals agree exactly, and
+		 * 0x88040000 is also u-boot's DFS_ADDR, the address its Android
+		 * path loads the pm_sys partition to.
+		 */
+		sipc_pmsys_region: smem@88000000 {
+			reg = <0x0 0x88000000 0x0 0x40000>;
+			no-map;
+		};
+
+		pmsys_region: pmsys@88040000 {
+			reg = <0x0 0x88040000 0x0 0x2c0000>;
+			no-map;
+		};
+
 		audiodsp_reserved: audiodsp-mem@89000000 {
 			reg = <0x0 0x89000000 0x0 0x600000>;
 			no-map;
@@ -495,6 +514,68 @@ soc: soc {
 		#size-cells = <2>;
 		ranges;
 
+		/*
+		 * CM4 sensor hub. reg is the SP IRAM the bootcode stub is
+		 * poked into - stock exposes the same window as a bare
+		 * sp-iram@dc00 node (aliased iram_reserved) and u-boot writes
+		 * its built-in sp_loader[] array there, which is what
+		 * pm_bootcode.bin is generated from. dma-ranges is the CM4's
+		 * view of the shared DDR and matches the second smem-info
+		 * triple in the stock sipc-pmsys node, 0x88000000 -> 0x18000000.
+		 */
+		pmsys@dc00 {
+			compatible = "sprd,ums512-pmsys";
+			reg = <0x0 0xdc00 0x0 0x2000>;
+			dma-ranges = <0x18000000 0x0 0x88000000 0x08000000>;
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			sprd,syscon-aon-apb = <&aon_apb_regs>;
+
+			resets = <&pmu_gate RESET_PMU_APB_SP_SYS_SOFT_RST>;
+
+			memory-region = <&pmsys_region>;
+			firmware-name = "sprd/pm_bootcode.bin", "sprd/pm_sys.bin";
+
+			sipc {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				label = "pmsys";
+
+				mboxes = <&mailbox 1>, <&mailbox 6>;
+
+				memory-region = <&sipc_pmsys_region>;
+
+				/*
+				 * Buffer geometry is stock's, whose 5.4 binding
+				 * spells the same channel as an spipe named
+				 * "spipe_pm": ringnr 2, txbuf 0x180, rxbuf 0xb00.
+				 */
+				channel@4 {
+					reg = <4>;
+					sprd,channel-type = "sbuf";
+					sprd,channel-name = "pm_shub";
+					#address-cells = <1>;
+					#size-cells = <1>;
+					sprd,num-buffers = <2>;
+					sprd,tx-buf-size = <0x180>;
+					sprd,rx-buf-size = <0xb00>;
+
+					rpmsg@0 {
+						compatible = "sprd,shub";
+						reg = <0>, <0>;
+						sprd,channel-name = "shub_main";
+					};
+
+					rpmsg@1 {
+						reg = <1>, <1>;
+						sprd,channel-name = "shub_nowakeup";
+					};
+				};
+			};
+		};
+
 		gic: interrupt-controller@12000000 {
 			compatible = "arm,gic-v3";
 			reg = <0x0 0x12000000 0 0x20000>,	/* GICD */
diff --git a/arch/arm64/configs/ums512_defconfig b/arch/arm64/configs/ums512_defconfig
index 93e7b8bab..1e54f5673 100644
--- a/arch/arm64/configs/ums512_defconfig
+++ b/arch/arm64/configs/ums512_defconfig
@@ -723,6 +723,13 @@ CONFIG_MAX9611=m
 CONFIG_SC27XX_ADC=y
 CONFIG_TI_ADS1015=m
 CONFIG_IIO_ST_LSM6DSX=m
+CONFIG_IIO_SPRD_SHUB=y
+CONFIG_IIO_SPRD_SHUB_ACCEL=y
+CONFIG_IIO_SPRD_SHUB_GYRO=y
+CONFIG_IIO_SPRD_SHUB_LIGHT=y
+CONFIG_IIO_SPRD_SHUB_MAGN=y
+CONFIG_IIO_SPRD_SHUB_COMPASS=y
+CONFIG_IIO_SPRD_SHUB_PROXIMITY=y
 CONFIG_SENSORS_ISL29018=m
 CONFIG_VCNL4000=m
 CONFIG_IIO_ST_MAGN_3AXIS=m
diff --git a/drivers/remoteproc/sprd_pmsys.c b/drivers/remoteproc/sprd_pmsys.c
index 9685684d2..a84bd3175 100644
--- a/drivers/remoteproc/sprd_pmsys.c
+++ b/drivers/remoteproc/sprd_pmsys.c
@@ -209,8 +209,20 @@ static const struct sprd_pmsys_info ums9230_pmsys_info = {
 	.corereset_mask = BIT(0),
 };
 
+/*
+ * ums512 keeps the SP core reset in the same AON_APB bit as ums9230. The
+ * vendor 5.4 DT states it independently - its unisoc,modem node carries
+ * syscon2 = <&aon_apb 0x8c 0x1> under syscon-names "corereset" - so the two
+ * agreeing is a cross-check, not an assumption inherited from ums9230.
+ */
+static const struct sprd_pmsys_info ums512_pmsys_info = {
+	.corereset_reg = 0x008c,
+	.corereset_mask = BIT(0),
+};
+
 static const struct of_device_id sprd_pmsys_of_match[] = {
 	{ .compatible = "sprd,ums9230-pmsys", .data = &ums9230_pmsys_info },
+	{ .compatible = "sprd,ums512-pmsys", .data = &ums512_pmsys_info },
 	{ }
 };
 MODULE_DEVICE_TABLE(of, sprd_pmsys_of_match);
