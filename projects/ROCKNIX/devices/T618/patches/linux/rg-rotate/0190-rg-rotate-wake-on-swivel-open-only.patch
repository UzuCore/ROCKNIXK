From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Noxwell <beebono@yahoo.com>
Date: Tue, 28 Jul 2026 05:53:31 -0500
Subject: [PATCH 190/225] rg-rotate: wake on swivel open only

---
 arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts b/arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts
index 2fb8089b8..2b04e1c0d 100644
--- a/arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts
+++ b/arch/arm64/boot/dts/sprd/ums512-rg-rotate.dts
@@ -7,6 +7,7 @@
 
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/input/input.h>
+#include <dt-bindings/input/gpio-keys.h>
 #include <dt-bindings/clock/sprd,ums512-clk.h>
 #include <dt-bindings/mfd/sprd,sc2730-regs.h>
 #include <dt-bindings/mfd/sprd,sc2730-mask.h>
@@ -216,6 +217,16 @@ sw-hall {
 			gpios = <&ap_gpio 54 GPIO_ACTIVE_LOW>;
 			debounce-interval = <10>;
 			wakeup-source;
+			/*
+			 * Wake on open only. The gpio is active-low and
+			 * asserted means closed, so DEASSERTED is the
+			 * opening edge; gpio-keys retypes the irq to that
+			 * single edge for the duration of suspend. Without
+			 * this the trigger stays EDGE_BOTH and closing the
+			 * swivel wakes a device that was put to sleep with
+			 * the power key.
+			 */
+			wakeup-event-action = <EV_ACT_DEASSERTED>;
 		};
 		key-volumedown {
 			label = "Volume Down Key";
