+		top-dvfs-adi-state = <0x70 0 0xf>;
+		voltage-grade-num = <7>;
+		voltage-grade = <0 0xf0 0xf4 0 0x1ff>,
+			<1 0xf0 0xf4 9 0x1ff>,
+			<2 0x100 0xf4 18 0x1ff>,
+			<3 0x110 0xf8 0 0x1ff>,
