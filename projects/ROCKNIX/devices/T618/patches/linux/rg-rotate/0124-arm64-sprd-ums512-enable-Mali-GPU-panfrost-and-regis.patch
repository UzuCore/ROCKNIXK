+/* Mali-G52 MP2 (Bifrost) via mainline panfrost. SoC gpu@60000000 + gpu_opp_table
+ * + pmu power-controller + gpu_clk reset ported into ums512.dtsi.
+ * (memory: gpu-panfrost-bringup) */
+&gpu {
+	mali-supply = <&vddgpu>;
+	status = "okay";
+};
+
+/* Register-level CPU DVFS (sprd-cpufreqhw / hwdvfs — the SMCCC sprd-cpufreq-v2
+ * path is a dead end: stock firmware returns NOT_SUPPORTED for SPRD_SIP_SVC_DVFS_*).
+ * policy0 = cpu0-5 (A55), policy6 = cpu6-7 (A75). dcdc_cpu0/1 cells + cpudvfs_dev
+ * ported into ums512.dtsi. (memory: thermal-cpufreq-bringup) */
+&dcdc_cpu0 {
+	dcdc-supply-mode-cfg = <&dvfs_dcdc_cpu0_supply>;
+};
+
+&dcdc_cpu1 {
+	dcdc-supply-mode-cfg = <&dvfs_dcdc_cpu1_supply>;
+};
+
+&cpudvfs_dev {
+	status = "okay";
+};
