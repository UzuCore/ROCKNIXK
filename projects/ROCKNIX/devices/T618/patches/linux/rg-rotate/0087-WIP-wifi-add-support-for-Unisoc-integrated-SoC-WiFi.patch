+
+enum sc23xx_vif_mode {
+	SC23XX_MODE_NONE = 0,
+	SC23XX_MODE_STATION = 1,
+	SC23XX_MODE_AP = 2,
+	SC23XX_MODE_NPI = 3,
+	SC23XX_MODE_P2P_DEVICE = 4,
+	SC23XX_MODE_P2P_CLIENT = 5,
+	SC23XX_MODE_P2P_GO = 6,
+	SC23XX_MODE_IBSS = 7,
