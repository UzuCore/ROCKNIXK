Subject: [PATCH] sprd: dvfs-i2c support for UMS512

Consolidated from beebono/linux-mainline-sprd rg-rotate 464b3e7bf45bb300e190339977abba36c8078e1f, rebased onto Linux 7.1.2.
Original authors and patch hashes are recorded in series-origin.json.

diff --git a/drivers/cpufreq/Kconfig.arm b/drivers/cpufreq/Kconfig.arm
index 47c9b031f1b3b83831390711fe449d5f9cc5281e..8966ea984470bba2d5f113b8b19aef554a9822eb 100644
--- a/drivers/cpufreq/Kconfig.arm
+++ b/drivers/cpufreq/Kconfig.arm
@@ -212,6 +212,51 @@ config ARM_SPEAR_CPUFREQ
 	help
 	  This adds the CPUFreq driver support for SPEAr SOCs.
 
+config ARM_SPRD_CPUFREQ_V2
+	bool "Spreadtrum/Unisoc CPUFreq v2 support"
+	depends on ARCH_SPRD || COMPILE_TEST
+	default y
+	help
+	  This adds the CPUFreq driver support for Spreadtrum/Unisoc SoCs.
+
+config ARM_SPRD_HW_CPUFREQ_NORMAL
+	bool "Sprd apcpu hardware dvfs driver for sharkl5 family SOCs"
+	depends on ARCH_SPRD || COMPILE_TEST
+	select PM_OPP
+	default y if ARCH_SPRD
+	help
+	  This driver enable hardware to adjust the voltage and frequency
+	  automatically for DSU cluster and cores in sharkl5 and the platforms
+	  whose apcpu hardware DVFS IP is similar to sharkl5.
+
+	  If in doubt, say N.
+
+config ARM_SPRD_HW_CPUFREQ_ARCH_UMS512
+	bool "SPRD UMS512 HW DVFS Driver"
+	depends on ARM_SPRD_HW_CPUFREQ_NORMAL
+	default y if ARCH_SPRD
+	help
+	  This includes SPRD UMS512 HW DVFS Architecture-dependent Driver
+
+	  If in doubt, say N.
+
+config ARM_SPRD_CPUFREQ_PUBLIC
+	bool "SPRD CPUfreq Driver Public Data"
+	default y if ARCH_SPRD
+	help
+	  This includes all SPRD cpufreq driver public data, including but
+	  not limted to the EXPORT SYMBOL with the same name.
+
+	  If in doubt, say N.
+
+config ARM_SPRD_TOP_DVFS
+	bool "Spreadtrum/Unisoc TOP DVFS subsystem-DCDC driver"
+	depends on ARCH_SPRD || COMPILE_TEST
+	default y if ARCH_SPRD
+	help
+	  This drives the TOP DVFS controller's subsystem/device DCDC voltage
+	  management (non-CPU rails) on sharkl5pro-family SoCs.
+
 config ARM_STI_CPUFREQ
 	tristate "STi CPUFreq support"
 	depends on CPUFREQ_DT
diff --git a/drivers/cpufreq/Makefile b/drivers/cpufreq/Makefile
index 385c9fcc65c625226f91941f8d01682c2437a62b..da824cb989863918bf10551629b5bc75a993d5ed 100644
--- a/drivers/cpufreq/Makefile
+++ b/drivers/cpufreq/Makefile
@@ -80,6 +80,11 @@ obj-$(CONFIG_ARM_SA1110_CPUFREQ)	+= sa1110-cpufreq.o
 obj-$(CONFIG_ARM_SCMI_CPUFREQ)		+= scmi-cpufreq.o
 obj-$(CONFIG_ARM_SCPI_CPUFREQ)		+= scpi-cpufreq.o
 obj-$(CONFIG_ARM_SPEAR_CPUFREQ)		+= spear-cpufreq.o
+obj-$(CONFIG_ARM_SPRD_CPUFREQ_V2)	+= sprd-cpufreq-v2.o
+obj-$(CONFIG_ARM_SPRD_HW_CPUFREQ_NORMAL)	+= sprd-hwdvfs-cpufreq.o sprd-hwdvfs-debugfs.o
+obj-$(CONFIG_ARM_SPRD_HW_CPUFREQ_ARCH_UMS512)	+= sprd-hwdvfs-normal.o sprd-hwdvfs-ums512.o
