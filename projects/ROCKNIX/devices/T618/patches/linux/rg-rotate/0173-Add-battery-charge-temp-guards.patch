+
 	of_node_put(bq->notify_node);
 	bq2415x_power_supply_exit(bq);
 
@@ -1829,6 +2000,7 @@ static const struct i2c_device_id bq2415x_i2c_id_table[] = {
 	{ "bq24156a", BQ24156A },
