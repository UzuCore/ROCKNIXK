Subject: [PATCH] sprd: soc-ipc support for UMS512

Consolidated from beebono/linux-mainline-sprd rg-rotate 464b3e7bf45bb300e190339977abba36c8078e1f, rebased onto Linux 7.1.2.
Original authors and patch hashes are recorded in series-origin.json.

diff --git a/drivers/remoteproc/Kconfig b/drivers/remoteproc/Kconfig
index ee54436fea5ad08a9c198ce74d44ce7a9aa206de..bda2a7939d8fd0fb3724714ff4c27e3b01122473 100644
--- a/drivers/remoteproc/Kconfig
+++ b/drivers/remoteproc/Kconfig
@@ -300,6 +300,33 @@ config RCAR_REMOTEPROC
 	  This can be either built-in or a loadable module.
 	  If compiled as module (M), the module name is rcar_rproc.
 
+config SPRD_REMOTEPROC_COMMON
+	tristate
+
+config SPRD_MODEM_REMOTEPROC
+	tristate "Unisoc integrated modem processor support"
+	depends on ARCH_SPRD || COMPILE_TEST
+	select SPRD_REMOTEPROC_COMMON
+	help
+	  Say y here to support the integrated modem processor (also
+	  known as PUBCP) found on Spreadtrum/Unisoc SoCs.
+
+config SPRD_PMSYS_REMOTEPROC
+	tristate "Unisoc PMSYS remoteproc support"
+	depends on ARCH_SPRD || COMPILE_TEST
+	select SPRD_REMOTEPROC_COMMON
+	help
+	  Say y here to support the PMSYS remote processor found on
+	  Spreadtrum/Unisoc SoCs.
+
+config SPRD_WCN_REMOTEPROC
+	tristate "Unisoc wireless connectivity processor support"
+	depends on ARCH_SPRD || COMPILE_TEST
+	select SPRD_REMOTEPROC_COMMON
+	help
+	  Say y here to support the integrated WCN processor found on
+	  Spreadtrum/Unisoc SoCs.
+
 config ST_REMOTEPROC
 	tristate "ST remoteproc support"
 	depends on ARCH_STI
diff --git a/drivers/remoteproc/Makefile b/drivers/remoteproc/Makefile
index 1c7598b8475d6057a3e044b41e3515103b7aa9f1..d7a3c005e7c1146586e2cb22817084ff1f68e385 100644
--- a/drivers/remoteproc/Makefile
+++ b/drivers/remoteproc/Makefile
@@ -33,6 +33,10 @@ obj-$(CONFIG_QCOM_WCNSS_PIL)		+= qcom_wcnss_pil.o
 qcom_wcnss_pil-y			+= qcom_wcnss.o
