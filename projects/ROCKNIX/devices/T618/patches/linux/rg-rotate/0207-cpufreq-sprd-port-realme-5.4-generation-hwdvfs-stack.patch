-	for (clu = 0; clu < pdev->total_cluster_num; ++clu) {
-		cluster = pdev->cluster_array[clu];
-		for (ix = 0; ix < cluster->device_num; ++ix) {
-			attrgp[id].name = cluster->subdevs[ix].name;
-			attrgp[id].group = &apcpu_attr_group;
