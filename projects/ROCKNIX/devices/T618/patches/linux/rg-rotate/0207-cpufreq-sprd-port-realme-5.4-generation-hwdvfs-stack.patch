-struct sprd_cpudvfs_device *sprd_hardware_dvfs_device_get(void)
-{
-	if (plat_dev && !plat_dev->archdata) {
-		pr_err("No cpu dvfs private data found\n");
-		return NULL;
-	}
-
-	return plat_dev;
-}
-EXPORT_SYMBOL_GPL(sprd_hardware_dvfs_device_get);
