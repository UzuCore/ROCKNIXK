-static int sprd_cpufreq_bin_read(struct device_node *np,
-				 const char *cell_id,
-				 u32 *val)
-{
-	struct nvmem_cell *cell;
-	void *buf;
-	size_t len;
-
-	cell = of_nvmem_cell_get(np, cell_id);
-	if (IS_ERR(cell))
-		return PTR_ERR(cell);
-
-	buf = nvmem_cell_read(cell, &len);
