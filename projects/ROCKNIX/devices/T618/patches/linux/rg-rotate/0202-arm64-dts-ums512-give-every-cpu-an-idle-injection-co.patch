 arch/arm64/boot/dts/sprd/ums512.dtsi | 139 +++++++++++++++++++++++----
 1 file changed, 120 insertions(+), 19 deletions(-)

diff --git a/arch/arm64/boot/dts/sprd/ums512.dtsi b/arch/arm64/boot/dts/sprd/ums512.dtsi
index 2bf1bdc12..bc96112a9 100644
--- a/arch/arm64/boot/dts/sprd/ums512.dtsi
+++ b/arch/arm64/boot/dts/sprd/ums512.dtsi
@@ -193,15 +193,22 @@ CPU0: cpu@0 {
 
 			/*
 			 * Throttle by injecting idle rather than by scaling
-			 * frequency: the vendor hw dvfs block accepts a work
-			 * index but never applies it (state stays IDLE, voted
-			 * volt reads 0), so the cpufreq cooling devices above
-			 * are inert on this platform.
+			 * frequency: the vendor hw dvfs block latches a work
+			 * index and moves the voltage grade, but the clock
+			 * never follows. Measured with the PMU cycle counter
+			 * against a pinned busy loop, cluster0 sits at a fixed
+			 * 1536MHz and cluster1 at 1228.8MHz no matter what is
+			 * requested, so the cpufreq cooling devices above are
+			 * inert on this platform.
 			 *
-			 * cpuidle_cooling_register() injects across the whole
-			 * cpuidle driver cpumask, so one node covers every cpu
-			 * it serves - a node per cpu would just create
-			 * duplicate devices contending with each other.
+			 * A thermal-idle node is needed on *every* cpu. psci
+			 * registers one cpuidle driver per cpu
+			 * (cpuidle-psci.c: drv->cpumask = cpumask_of(cpu)), and
+			 * cpuidle_cooling_register() passes that mask straight
+			 * to idle_inject_register(), so a node covers exactly
+			 * the one cpu it hangs off - not the cluster. A single
+			 * node on CPU0 throttled 1 core out of 8 and let the
+			 * die run away to 101C under load.
 			 */
 			/*
 			 * State is a percentage of injected idle, and
@@ -215,7 +222,7 @@ CPU0: cpu@0 {
 			 * injected idle period is long enough to actually
 			 * enter the deep state rather than just wfi.
 			 */
-			cpu_idle_cooling: thermal-idle {
+			cpu0_idle_cooling: thermal-idle {
 				#cooling-cells = <2>;
 				duration-us = <10000>;
 				/* >= CORE_PD exit-latency-us so it can be used */
@@ -234,6 +241,14 @@ CPU1: cpu@100 {
 			capacity-dmips-mhz = <544>;
 			dynamic-power-coefficient = <102>;
 			#cooling-cells = <2>;
+
+			/* see CPU0: one node per cpu, psci gives one cpuidle driver each */
+			cpu1_idle_cooling: thermal-idle {
+				#cooling-cells = <2>;
+				duration-us = <10000>;
+				/* >= CORE_PD exit-latency-us so it can be used */
+				exit-latency-us = <4000>;
+			};
 		};
 
