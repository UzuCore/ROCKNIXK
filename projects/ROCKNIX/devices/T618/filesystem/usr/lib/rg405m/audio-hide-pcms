#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# RG405M: keep only NORMAL_AP01 (device 0) of the Unisoc VBC card. Opening one of the other DSP scene PCMs
# (LOOP, VOICE, FM, DUMP, ...) that the DSP firmware never answers times out the IPC and the vendor driver
# then treats the audio DSP as dead until reboot.
c=$(readlink /proc/asound/RG405M 2>/dev/null); c=${c#card}
[ -n "$c" ] || exit 0
for n in /dev/snd/pcmC${c}D*; do
  case "${n##*/}" in pcmC${c}D0p|pcmC${c}D0c) ;; *) rm -f "$n" ;; esac
done
exit 0
