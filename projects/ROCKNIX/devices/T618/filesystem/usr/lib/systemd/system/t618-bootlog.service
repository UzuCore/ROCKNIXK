[Unit]
Description=RG405M bring-up boot log to /flash
DefaultDependencies=no
After=systemd-journald.service
# Diagnostics only: remounts the FAT boot partition rw every 10 s for 5 minutes.
# Enable by creating an empty file named "t618-bootlog" on the ROCKNIX (FAT) partition.
ConditionPathExists=/flash/t618-bootlog

[Service]
Type=simple
ExecStart=/usr/bin/t618-bootlog

[Install]
WantedBy=sysinit.target fs-resize.target
