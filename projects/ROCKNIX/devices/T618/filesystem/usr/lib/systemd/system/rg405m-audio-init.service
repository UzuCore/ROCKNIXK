[Unit]
Description=RG405M audio routing before PipeWire (DPCM FE->BE switches)
DefaultDependencies=no
After=systemd-modules-load.service local-fs.target systemd-udevd.service systemd-udev-settle.service
Before=pipewire.service wireplumber.service pipewire.socket
ConditionPathExists=/proc/asound/RG405M

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/bin/sh /usr/lib/rg405m/audio-hide-pcms
ExecStart=-/usr/bin/alsaucm -c RG405M set _verb HiFi set _enadev Speaker

[Install]
WantedBy=sysinit.target
