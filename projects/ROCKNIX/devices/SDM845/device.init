#!/bin/sh

device_load_splash() {
  local tries rows lines first_row message

  # Wait for the portrait EFI framebuffer to hand over to the rotated DRM console.
  tries=0
  while [ "$(cat /sys/class/graphics/fb0/name 2>/dev/null)" != "msmdrmfb" ] && [ "$tries" -lt 100 ]; do
    usleep 50000
    tries=$((tries + 1))
  done
  set_consolefont
  rows=$(od -An -tu1 -N1 /dev/vcsa1 2>/dev/null | tr -d ' ')
  case "$rows" in ''|*[!0-9]*) rows=25 ;; esac
  lines=$(wc -l </sysroot/etc/issue)
  first_row=$((rows - lines - 3))
  [ "$first_row" -ge 1 ] || first_row=1
  if [ -f /storage/.configured ]; then
    message='==> Loading, please wait...'
  else
    message='==> Initializing, please wait...'
  fi
  {
    printf '\033[r\033[2J\033[%s;1H' "$first_row"
    cat /sysroot/etc/issue
    printf '\n%s\033[?25l' "$message"
  } >/dev/tty1
}
