From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rxodin <rxodin@localhost>
Date: Wed, 30 Sep 2026 13:01:12 +0900
Subject: [PATCH] drm/panel: innolux-td4328: support both AYN Odin panel
 revisions

The generated sequence in the jenneron tree comes from the Odin M2 vendor device tree. Bind it to innolux,td4328-m2 and restore the plain DCS sequence of the original Odin kernels (tjstyle 5.18, Batocera) for innolux,td4328. Also report the panel orientation from the rotation property.
---
 drivers/gpu/drm/panel/panel-innolux-td4328.c | 88 ++++++++++++++++----
 1 file changed, 70 insertions(+), 18 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-innolux-td4328.c b/drivers/gpu/drm/panel/panel-innolux-td4328.c
index 5461dd4..7bc12ba 100644
--- a/drivers/gpu/drm/panel/panel-innolux-td4328.c
+++ b/drivers/gpu/drm/panel/panel-innolux-td4328.c
@@ -1,4 +1,5 @@
 // SPDX-License-Identifier: GPL-2.0-only
+// Copyright (c) 2022 Teguh Sobirin <teguh@sobir.in>
 // Copyright (c) 2026 FIXME
 // Generated with linux-mdss-dsi-panel-driver-generator from vendor device tree:
 //   Copyright (c) 2013, The Linux Foundation. All rights reserved. (FIXME)
@@ -7,6 +8,8 @@
 #include <linux/gpio/consumer.h>
 #include <linux/mod_devicetable.h>
 #include <linux/module.h>
+#include <linux/of.h>
+#include <linux/property.h>
 #include <linux/regulator/consumer.h>
 
 #include <drm/drm_mipi_dsi.h>
@@ -14,14 +17,20 @@
 #include <drm/drm_panel.h>
 #include <drm/drm_probe_helper.h>
 
+struct innolux_td4328_desc {
+	void (*init)(struct mipi_dsi_multi_context *dsi_ctx);
+};
+
 struct innolux_td4328 {
 	struct drm_panel panel;
 	struct mipi_dsi_device *dsi;
+	const struct innolux_td4328_desc *desc;
 	struct regulator *vddio;
 	struct regulator *vddpos;
 	struct regulator *vddneg;
 	struct gpio_desc *enable_gpio;
 	struct gpio_desc *reset_gpio;
+	enum drm_panel_orientation orientation;
 };
 
 static inline struct innolux_td4328 *to_innolux_td4328(struct drm_panel *panel)
@@ -39,27 +48,45 @@ static void innolux_td4328_reset(struct innolux_td4328 *ctx)
 	msleep(80);
 }
 
-static int innolux_td4328_on(struct innolux_td4328 *ctx)
+/* AYN Odin: plain DCS sequence used by the original Odin kernels */
+static void innolux_td4328_odin_init(struct mipi_dsi_multi_context *dsi_ctx)
 {
-	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
-
-	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	mipi_dsi_dcs_exit_sleep_mode_multi(dsi_ctx);
+	mipi_dsi_msleep(dsi_ctx, 150);
+	mipi_dsi_dcs_set_column_address_multi(dsi_ctx, 0x0000, 0x0437);
+	mipi_dsi_dcs_set_page_address_multi(dsi_ctx, 0x0000, 0x077f);
+	mipi_dsi_dcs_set_tear_on_multi(dsi_ctx, MIPI_DSI_DCS_TEAR_MODE_VBLANK);
+	mipi_dsi_dcs_set_display_on_multi(dsi_ctx);
+	mipi_dsi_msleep(dsi_ctx, 50);
+}
 
-	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xb0, 0x00);
-	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xc2,
+/* AYN Odin M2: sequence generated from the Odin M2 vendor device tree */
+static void innolux_td4328_odin_m2_init(struct mipi_dsi_multi_context *dsi_ctx)
+{
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xb0, 0x00);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xc2,
 					 0x01, 0xf7, 0x80, 0x04, 0x68, 0x08,
 					 0x09, 0x10, 0x00, 0x08, 0x30, 0x00,
 					 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
 					 0x02, 0x80, 0x00, 0x00, 0x00);
-	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xd6, 0x01);
-	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xb0, 0x03);
-	mipi_dsi_dcs_set_column_address_multi(&dsi_ctx, 0x0000, 0x0437);
-	mipi_dsi_dcs_set_page_address_multi(&dsi_ctx, 0x0000, 0x077f);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x35);
-	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
-	mipi_dsi_msleep(&dsi_ctx, 150);
-	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
-	mipi_dsi_msleep(&dsi_ctx, 50);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xd6, 0x01);
+	mipi_dsi_generic_write_seq_multi(dsi_ctx, 0xb0, 0x03);
+	mipi_dsi_dcs_set_column_address_multi(dsi_ctx, 0x0000, 0x0437);
+	mipi_dsi_dcs_set_page_address_multi(dsi_ctx, 0x0000, 0x077f);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0x35);
+	mipi_dsi_dcs_exit_sleep_mode_multi(dsi_ctx);
+	mipi_dsi_msleep(dsi_ctx, 150);
+	mipi_dsi_dcs_set_display_on_multi(dsi_ctx);
+	mipi_dsi_msleep(dsi_ctx, 50);
+}
+
+static int innolux_td4328_on(struct innolux_td4328 *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	ctx->desc->init(&dsi_ctx);
 
 	return dsi_ctx.accum_err;
 }
@@ -165,10 +192,18 @@ static int innolux_td4328_get_modes(struct drm_panel *panel,
 	return drm_connector_helper_get_modes_fixed(connector, &innolux_td4328_mode);
 }
 
+static enum drm_panel_orientation innolux_td4328_get_orientation(struct drm_panel *panel)
+{
+	struct innolux_td4328 *ctx = to_innolux_td4328(panel);
+
+	return ctx->orientation;
+}
+
 static const struct drm_panel_funcs innolux_td4328_panel_funcs = {
 	.prepare = innolux_td4328_prepare,
 	.unprepare = innolux_td4328_unprepare,
 	.get_modes = innolux_td4328_get_modes,
+	.get_orientation = innolux_td4328_get_orientation,
 };
 
 static int innolux_td4328_probe(struct mipi_dsi_device *dsi)
@@ -183,6 +218,10 @@ static int innolux_td4328_probe(struct mipi_dsi_device *dsi)
 	if (IS_ERR(ctx))
 		return PTR_ERR(ctx);
 
+	ctx->desc = device_get_match_data(dev);
+	if (!ctx->desc)
+		return -ENODEV;
+
 	ctx->vddio = devm_regulator_get(dev, "vddio");
 	if (IS_ERR(ctx->vddio))
 		return dev_err_probe(dev, PTR_ERR(ctx->vddio),
@@ -208,6 +247,10 @@ static int innolux_td4328_probe(struct mipi_dsi_device *dsi)
 		return dev_err_probe(dev, PTR_ERR(ctx->enable_gpio),
 				     "Failed to get enable-gpios\n");
 
+	ret = of_drm_get_panel_orientation(dev->of_node, &ctx->orientation);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "Failed to get orientation\n");
+
 	ctx->dsi = dsi;
 	mipi_dsi_set_drvdata(dsi, ctx);
 
@@ -245,8 +288,17 @@ static void innolux_td4328_remove(struct mipi_dsi_device *dsi)
 	drm_panel_remove(&ctx->panel);
 }
 
+static const struct innolux_td4328_desc innolux_td4328_odin_desc = {
+	.init = innolux_td4328_odin_init,
+};
+
+static const struct innolux_td4328_desc innolux_td4328_odin_m2_desc = {
+	.init = innolux_td4328_odin_m2_init,
+};
+
 static const struct of_device_id innolux_td4328_of_match[] = {
-	{ .compatible = "innolux,td4328" }, // FIXME
+	{ .compatible = "innolux,td4328", .data = &innolux_td4328_odin_desc },
+	{ .compatible = "innolux,td4328-m2", .data = &innolux_td4328_odin_m2_desc },
 	{ /* sentinel */ }
 };
 MODULE_DEVICE_TABLE(of, innolux_td4328_of_match);
@@ -261,6 +313,6 @@ static struct mipi_dsi_driver innolux_td4328_driver = {
 };
 module_mipi_dsi_driver(innolux_td4328_driver);
 
-MODULE_AUTHOR("linux-mdss-dsi-panel-driver-generator <fix@me>"); // FIXME
-MODULE_DESCRIPTION("DRM driver for TD4328 cmd mode dsi panel without DSC");
+MODULE_AUTHOR("Teguh Sobirin <teguh@sobir.in>");
+MODULE_DESCRIPTION("DRM driver for Innolux TD4328 cmd mode DSI panel (AYN Odin)");
 MODULE_LICENSE("GPL");
