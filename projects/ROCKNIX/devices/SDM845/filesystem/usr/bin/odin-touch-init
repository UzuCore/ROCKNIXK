#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
set -eu
[ "$(tr -d '\0' </proc/device-tree/model)" = 'AYN Odin M2' ] || exit 0
DEVICE=/sys/bus/i2c/devices/5-0020
DRIVER=/sys/bus/i2c/drivers/rmi4_i2c
[ -d "$DEVICE" ] || exit 0
export XDG_RUNTIME_DIR=/var/run/0-runtime-dir
export SWAYSOCK=/var/run/0-runtime-dir/sway-ipc.0.sock
for attempt in $(seq 1 30); do
  [ ! -L "$DEVICE/driver" ] || exit 0
  if swaymsg -r -t get_outputs 2>/dev/null | python3 -c 'import json,sys; outputs=json.load(sys.stdin); sys.exit(not any(o.get("name")=="DSI-1" and o.get("active") and o.get("power", True) for o in outputs))' 2>/dev/null; then
    if [ -e "$DRIVER/bind" ]; then
      if printf '5-0020\n' >"$DRIVER/bind"; then
        [ ! -L "$DEVICE/driver" ] || { echo 'Odin M2 touch registered after display startup'; exit 0; }
      fi
    fi
  fi
  sleep 1
done
echo 'Odin M2 touch did not register after display startup' >&2
exit 1
