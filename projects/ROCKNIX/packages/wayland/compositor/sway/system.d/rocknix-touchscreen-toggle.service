# /usr/lib/systemd/system/rocknix-touchscreen-toggle.service
[Unit]
Description=Apply saved touchscreen enabled/disabled state
After=essway.service sway-touch.service
Wants=essway.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=HOME=/storage
ExecStart=/usr/bin/rocknix-touchscreen-toggle apply

[Install]
WantedBy=rocknix.target
