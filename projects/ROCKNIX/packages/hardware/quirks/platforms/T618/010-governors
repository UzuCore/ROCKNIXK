#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Discover live kernel interfaces; never assume Rockchip/Qualcomm node paths.
mkdir -p /storage/.config/profile.d
cat <<'EOF' >/storage/.config/profile.d/010-governors
CPU_FREQ=()
GPU_FREQ=()
DEVICE_TEMP_SENSOR=""
for t618_path in /sys/devices/system/cpu/cpufreq/policy*; do
  [ -r "${t618_path}/scaling_governor" ] && CPU_FREQ+=("${t618_path}")
done
for t618_path in /sys/class/devfreq/*; do
  [ -r "${t618_path}/governor" ] || continue
  t618_driver=$(readlink -f "${t618_path}/device/driver")
  case "${t618_driver##*/}" in
    panfrost) GPU_FREQ+=("${t618_path}");;
  esac
done
for t618_path in /sys/class/thermal/thermal_zone*; do
  [ -r "${t618_path}/type" ] && [ -r "${t618_path}/temp" ] || continue
  case "$(cat "${t618_path}/type")" in
    cputop*-thermal) DEVICE_TEMP_SENSOR="${DEVICE_TEMP_SENSOR:+${DEVICE_TEMP_SENSOR} }${t618_path}/temp";;
  esac
done
unset t618_path t618_driver
EOF
