#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# RG405M board features; do not inherit another SoC's overclock settings.
mkdir -p /storage/.config/profile.d
cat <<'EOF' >/storage/.config/profile.d/001-device_config
DEVICE_HAS_TOUCHSCREEN="true"
DEVICE_HAS_DUAL_SCREEN="false"
DEVICE_HAS_HDMI="false"
DEVICE_HAS_FAN="false"
DEVICE_GPU_OVERCLOCK="false"
DEVICE_TURBO_MODE="false"
DEVICE_BATTERY_LED_STATUS="false"
DEVICE_USB_CONFIGFS_DEBUG="true"
DEVICE_USB_CONFIGFS_DEBUG_SERVICE="t618-usb-shell.service"
EOF
