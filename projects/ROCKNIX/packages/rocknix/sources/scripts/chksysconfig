. /etc/profile

CFG_PATH="/storage/.config/system/configs"

backup() {
  TYPE=$(grep a ${CFG_PATH}/system.cfg 2>&1)
  if [[ ! "${TYPE}" =~ binary ]]
  then
    cp ${CFG_PATH}/system.cfg ${CFG_PATH}/system.cfg.backup
  fi
}

restore() {
  cp ${CFG_PATH}/system.cfg.backup ${CFG_PATH}/system.cfg
}

verify() {
  TYPE=$(grep a ${CFG_PATH}/system.cfg 2>&1)
  if [[ "${TYPE}" =~ binary ]]; then
    restore
  fi

  # Core options are generated by RetroArch and may legitimately be absent.
  if [ ! -s /storage/.config/retroarch/retroarch.cfg ]; then
    mkdir -p /storage/.config/retroarch
    cp /usr/config/retroarch/retroarch.cfg /storage/.config/retroarch/retroarch.cfg
  fi

  if ! grep -q '^system.hostname=' ${CFG_PATH}/system.cfg; then
    mkdir -p "${CFG_PATH}"
    if [ ! -s "${CFG_PATH}/system.cfg" ]; then
      cp /usr/config/system/configs/system.cfg "${CFG_PATH}/system.cfg"
    else
      set_setting system.hostname "$(hostname)"
    fi
  fi
}

case ${1} in
  verify)
    verify
  ;;
  backup)
    backup
  ;;
  restore)
    restore
  ;;
esac
