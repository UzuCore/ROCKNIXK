+++ b/es-app/src/guis/GuiMenu.cpp
@@ -1891,6 +1891,25 @@ void GuiMenu::openSystemSettings()
       if (Utils::Platform::GetEnv("DEVICE_SCANOUT_SCALING") == "true")
         s->addEntry(_("SCALING AND SHARPENING"), true, [this] { openResolutionScalingSettings(mWindow, ""); });
 
+      // Add option to enable / disable a real touchscreen panel.
+      // DEVICE_HAS_TOUCHSCREEN is set per platform, so the helper reports
+      // whether this unit actually has a panel and what state it is in.
+      std::string touchscreenState = Utils::Platform::GetShOutput("/usr/bin/rocknix-touchscreen-toggle query");
+      if (Utils::Platform::GetEnv("DEVICE_HAS_TOUCHSCREEN") == "true" && !touchscreenState.empty()){
+        auto touchscreen_toggle = std::make_shared<SwitchComponent>(mWindow);
+        touchscreen_toggle->setState(touchscreenState != "0");
+        s->addWithLabel(_("ENABLE TOUCHSCREEN"), touchscreen_toggle);
+        touchscreen_toggle->setOnChangedCallback([touchscreen_toggle] {
+                if (touchscreen_toggle->getState() == false) {
+                        Utils::Platform::runSystemCommand("/usr/bin/rocknix-touchscreen-toggle disable", "", nullptr);
+                } else {
+                        Utils::Platform::runSystemCommand("/usr/bin/rocknix-touchscreen-toggle enable", "", nullptr);
+                }
+                bool touchscreen_enabled_state = touchscreen_toggle->getState();
+                SystemConf::getInstance()->set("rocknix.touchscreen.enabled", touchscreen_enabled_state ? "1" : "0");
+        });
+      }
